---
export const prerender = true;

import FoundationPage from "../components/pages/FoundationPage.astro";
import {
  getFoundationPageContent,
} from "../content/foundation-page-content";
import {
  sitePages,
  type SitePage,
} from "../content/site-pages";
import Layout from "../layouts/Layout.astro";

export function getStaticPaths() {
  return sitePages.map((page) => ({
    params: {
      slug: page.path,
    },
    props: {
      page,
    },
  }));
}

interface Props {
  page: SitePage;
}

const { page } = Astro.props;
const content = getFoundationPageContent(page);
---

<Layout
  title={content.title}
  description={content.description}
  canonicalPath={`/${page.path}/`}
  noindex={page.noindex}
>
  <FoundationPage page={page} />
</Layout>
