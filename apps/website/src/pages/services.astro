---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Services | LK Professionals"
  description="Explore LK Professionals service lines across finance operations, compliance, and advisory delivery.">
  <main class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="font-display text-5xl text-brand-ink">Services</h1>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="rounded-3xl bg-white/80 p-8 shadow-lg shadow-brand-ink/5">
        <h2 class="font-display text-2xl">Advisory</h2>
        <p class="mt-3 text-slate-700">Operating model design, governance, and transformation planning.</p>
      </article>
      <article class="rounded-3xl bg-white/80 p-8 shadow-lg shadow-brand-ink/5">
        <h2 class="font-display text-2xl">Compliance</h2>
        <p class="mt-3 text-slate-700">Control frameworks, audit preparation, and policy implementation.</p>
      </article>
      <article class="rounded-3xl bg-white/80 p-8 shadow-lg shadow-brand-ink/5">
        <h2 class="font-display text-2xl">Financial Operations</h2>
        <p class="mt-3 text-slate-700">Process automation, reconciliations, and performance reporting.</p>
      </article>
    </div>
  </main>
</BaseLayout>

