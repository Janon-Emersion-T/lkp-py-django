---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | LK Professionals"
  description="Schedule a consultation with LK Professionals for advisory, compliance, and operations support.">
  <main class="mx-auto max-w-4xl px-6 py-20">
    <div class="rounded-[2rem] border border-white/60 bg-white/80 p-10 shadow-2xl shadow-brand-ink/10">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-gold">Contact</p>
      <h1 class="mt-4 font-display text-5xl text-brand-ink">Let’s scope the engagement.</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-700">
        For production use, connect this page to your form provider or backend lead endpoint. The static site stays SEO-friendly while submissions can be handled by an API or third-party workflow.
      </p>
      <a class="mt-8 inline-flex rounded-full bg-brand-ink px-6 py-3 text-sm font-semibold text-white" href="mailto:hello@lkprofessionals.com">
        hello@lkprofessionals.com
      </a>
    </div>
  </main>
</BaseLayout>

