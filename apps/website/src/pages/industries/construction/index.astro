const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name:
    "Construction Technology Solutions",
  provider: {
    "@type": "Organization",
    name: "LKProfessionals",
  },
  audience: {
    "@type": "BusinessAudience",
    audienceType:
      "Construction companies, contractors and project-based businesses",
  },
  areaServed: "Worldwide",
