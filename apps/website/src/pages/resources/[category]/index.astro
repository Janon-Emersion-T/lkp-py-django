---
import Layout from "../../../layouts/Layout.astro";

import ResourcesNav from "../../../components/resources/ResourcesNav.astro";
import ResourcesHero from "../../../components/resources/ResourcesHero.astro";
import ResourcesList from "../../../components/resources/ResourcesList.astro";

import {
  getResources,
} from "../../../lib/resources/api";

import {
  resourceCategories,
} from "../../../lib/resources/categories";

const { category } = Astro.params;

const config =
  category
    ? resourceCategories[category]
    : undefined;

if (!config) {
  Astro.response.status = 404;
}

const resources =
  config
    ? await getResources(
        config.resourceType,
      )
    : [];

const canonicalPath =
  config
    ? `/resources/${config.slug}/`
    : "/resources/";
---

<Layout
  title={config?.metaTitle ?? "Resources"}
  description={
    config?.metaDescription
    ?? "LKProfessionals resources."
  }
  canonicalPath={canonicalPath}
  noindex={!config}
>
  {
    config ? (
      <>
        <ResourcesNav
          activePath={`/resources/${config.slug}`}
        />

        <ResourcesHero
          eyebrow={`Resources / ${config.label}`}
          title={config.title}
          description={config.description}
        />

        <ResourcesList resources={resources} />
      </>
    ) : (
      <section class="resource-not-found">
        <div class="site-container">
          <p>404</p>
          <h1>Resource category not found.</h1>

          <a href="/resources/">
            Return to Resources
          </a>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .resource-not-found {
    padding-block: 8rem;
  }

  .resource-not-found p {
    color: #0b2f8f;
    font-weight: 800;
  }

  .resource-not-found h1 {
    color: #0b1e3a;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
  }

  .resource-not-found a {
    border-bottom: 1px solid #0b2f8f;
    color: #0b2f8f;
  }
</style>
