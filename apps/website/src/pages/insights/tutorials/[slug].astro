---
import Layout from "../../../layouts/Layout.astro";

import InsightsSectionNav from "../../../components/insights/InsightsSectionNav.astro";

import {
  getInsightBySlug,
} from "../../../lib/insights/api";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/insights/tutorials/");
}

const article =
  await getInsightBySlug(slug);

if (
  !article
  || article.category_slug !== "tutorials"
) {
  Astro.response.status = 404;
}

const title =
  article?.seo?.meta_title
  || article?.title
  || "Tutorial not found";

const description =
  article?.seo?.meta_description
  || article?.excerpt
  || "Technology tutorial from LKProfessionals.";

const canonicalPath =
  article
    ? `/insights/tutorials/${article.slug}/`
    : "/insights/tutorials/";

const sections =
  article?.content?.sections ?? [];

const schema =
  article
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: article.title,
        description: article.excerpt ?? "",
        datePublished:
          article.published_at ?? undefined,
        dateModified:
          article.updated_at ?? undefined,
        mainEntityOfPage:
          `https://lkprofessionals.com${canonicalPath}`,
      }
    : undefined;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={!article}
  structuredData={schema}
>
  <InsightsSectionNav
    activePath="/insights/tutorials"
  />

  {
    article ? (
      <>
        <article class="insight-article">
          <header class="site-container insight-article__header">
            <p class="insight-article__eyebrow">
              Insights / Tutorials
            </p>

            <h1>{article.title}</h1>

            {
              article.excerpt && (
                <p class="insight-article__excerpt">
                  {article.excerpt}
                </p>
              )
            }

            <div class="insight-article__meta">
              {
                article.published_at && (
                  <time
                    datetime={article.published_at}
                  >
                    {
                      new Intl.DateTimeFormat(
                        "en",
                        {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        },
                      ).format(
                        new Date(
                          article.published_at,
                        ),
                      )
                    }
                  </time>
                )
              }

              {
                article.reading_time_minutes && (
                  <span>
                    {
                      article
                        .reading_time_minutes
                    } min read
                  </span>
                )
              }
            </div>
          </header>

          <div class="site-container insight-article__body">
            {
              article.content?.intro && (
                <p class="insight-article__intro">
                  {article.content.intro}
                </p>
              )
            }

            {
              sections.map((section) => (
                <section>
                  {
                    section.heading && (
                      <h2>
                        {section.heading}
                      </h2>
                    )
                  }

                  {
                    section.body && (
                      <p>{section.body}</p>
                    )
                  }
                </section>
              ))
            }
          </div>
        </article>

      </>
    ) : (
      <section class="insight-not-found">
        <div class="site-container">
          <p>404</p>
          <h1>Tutorial not found.</h1>

          <a href="/insights/tutorials/">
            Return to tutorials
          </a>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .insight-article {
    background: #f7f9fc;
  }

  .insight-article__header {
    max-width: 62rem;
    padding-block:
      clamp(5rem, 10vw, 9rem)
      clamp(3rem, 6vw, 5rem);
  }

  .insight-article__eyebrow {
    margin: 0 0 1.2rem;
    color: #0b2f8f;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .insight-article h1 {
    margin: 0;
    color: #0b1e3a;
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 7vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .insight-article__excerpt {
    max-width: 48rem;
    margin: 2rem 0 0;
    color: #6d798b;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.75;
  }

  .insight-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-top: 1px solid #d5dde7;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    color: #758195;
    font-size: 0.7rem;
  }

  .insight-article__body {
    max-width: 48rem;
    border-top: 1px solid #d5dde7;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .insight-article__intro {
    margin: 0 0 3rem;
    color: #293b53;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    line-height: 1.45;
  }

  .insight-article__body section + section {
    border-top: 1px solid #d9e0e9;
    margin-top: 3rem;
    padding-top: 3rem;
  }

  .insight-article__body h2 {
    margin: 0;
    color: #0b1e3a;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .insight-article__body section p {
    margin: 1.2rem 0 0;
    color: #53647a;
    line-height: 1.9;
  }

  .insight-not-found {
    padding-block: 8rem;
  }

  .insight-not-found p {
    color: #0b2f8f;
    font-weight: 800;
  }

  .insight-not-found h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
  }

  .insight-not-found a {
    border-bottom: 1px solid #0b2f8f;
    color: #0b2f8f;
  }
</style>
