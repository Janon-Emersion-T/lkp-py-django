import MobileAppsCaseStudiesContext from "../../../components/case-studies/MobileAppsCaseStudiesContext.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Mobile App Case Studies",
  url:
    "https://lkprofessionals.com/case-studies/mobile-apps/",
  description:
    "Selected mobile application case studies from LKProfessionals covering business challenges, product decisions, engineering and project outcomes.",
