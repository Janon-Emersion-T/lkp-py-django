---
import Layout from "../layouts/Layout.astro";

import HomeHero from "../components/home/HomeHero.astro";
import HomePositioning from "../components/home/HomePositioning.astro";
import HomeServices from "../components/home/HomeServices.astro";
import HomeFeaturedWork from "../components/home/HomeFeaturedWork.astro";
import HomeIndustries from "../components/home/HomeIndustries.astro";
import HomeProcess from "../components/home/HomeProcess.astro";
import HomeWhyLkp from "../components/home/HomeWhyLkp.astro";
import HomeInsights from "../components/home/HomeInsights.astro";

import {
  getPortfolioProjects,
} from "../lib/portfolio/api";

import {
  getPublicInsights,
} from "../lib/insights/api";

const [
  allProjects,
  allInsights,
] = await Promise.all([
  getPortfolioProjects(),
  getPublicInsights(),
]);

const featuredProjects = [
  ...allProjects.filter(
    (project) => project.is_featured,
  ),
  ...allProjects.filter(
    (project) => !project.is_featured,
  ),
]
  .filter(
    (project, index, items) =>
      items.findIndex(
        (item) => item.id === project.id,
      ) === index,
  )
  .slice(0, 3);

const featuredInsights = [
  ...allInsights.filter(
    (insight) => insight.is_featured,
  ),
  ...allInsights.filter(
    (insight) => !insight.is_featured,
  ),
]
  .filter(
    (insight, index, items) =>
      items.findIndex(
        (item) => item.id === insight.id,
      ) === index,
  )
  .slice(0, 3);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "LKProfessionals",
    url: "https://lkprofessionals.com/",
    description:
      "LKProfessionals provides web development, software, mobile apps, AI, automation, infrastructure and digital growth services for organisations in Sri Lanka and internationally.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "LKProfessionals",
    url: "https://lkprofessionals.com/",
  },
];
---

<Layout
  title="LKProfessionals"
  description="LKProfessionals provides web development, custom software, mobile apps, AI, automation, infrastructure, digital marketing and business technology services from Jaffna, Sri Lanka."
  canonicalPath="/"
  structuredData={structuredData}
>
  <HomeHero />

  <HomeFeaturedWork
    projects={featuredProjects}
  />

  <HomePositioning />

  <HomeServices />

  <HomeIndustries />

  <HomeWhyLkp />

  <HomeProcess />

  <HomeInsights
    insights={featuredInsights}
  />
</Layout>
