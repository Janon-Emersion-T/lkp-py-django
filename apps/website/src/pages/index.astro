---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="LKProfessionals | IT Solutions for Modern Businesses"
	description="LKProfessionals provides web development, custom software, SEO, digital marketing, and business technology solutions."
>
	<main class="min-h-screen bg-slate-950 px-6 py-20 text-white">
		<div class="mx-auto max-w-6xl">
			<p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-sky-400">
				LKProfessionals
			</p>

			<h1 class="max-w-4xl text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
				Technology solutions built for serious business growth.
			</h1>

			<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
				Web development, custom software, SEO, digital marketing, and reliable IT services
				for businesses that expect measurable results.
			</p>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href="/contact"
					class="rounded-lg bg-sky-500 px-6 py-3 font-semibold text-white transition hover:bg-sky-400"
				>
					Request a quotation
				</a>

				<a
					href="/services"
					class="rounded-lg border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-slate-500 hover:bg-slate-900"
				>
					View services
				</a>
			</div>
		</div>
	</main>
</Layout>
