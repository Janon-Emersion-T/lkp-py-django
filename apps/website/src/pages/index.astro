---
import CompanyPositioning from "../components/sections/CompanyPositioning.astro";
import HomeCta from "../components/sections/HomeCta.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import ServicesOverview from "../components/sections/ServicesOverview.astro";
import WorkingMethod from "../components/sections/WorkingMethod.astro";
import Layout from "../layouts/Layout.astro";

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "LKProfessionals",
  url: "https://lkprofessionals.com/",
  description:
    "Reliable websites, business software and digital growth systems designed and developed by LKProfessionals.",
};
---

<Layout
  title="LKProfessionals"
  description="Reliable websites, business software and digital growth systems designed and developed by LKProfessionals."
  canonicalPath="/"
  structuredData={webpageSchema}
>
  <HomeHero />
  <ProofStrip />
  <ServicesOverview />
  <WorkingMethod />
  <CompanyPositioning />
  <HomeCta />
</Layout>
