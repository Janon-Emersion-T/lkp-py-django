---
import Layout from "../../../layouts/Layout.astro";
import ApiIntegrationHero from "../../../components/api-integration/ApiIntegrationHero.astro";
import ApiIntegrationOverview from "../../../components/api-integration/ApiIntegrationOverview.astro";
import ApiIntegrationServices from "../../../components/api-integration/ApiIntegrationServices.astro";
import ApiIntegrationPrinciples from "../../../components/api-integration/ApiIntegrationPrinciples.astro";
import ApiIntegrationFlow from "../../../components/api-integration/ApiIntegrationFlow.astro";
import ApiIntegrationRisks from "../../../components/api-integration/ApiIntegrationRisks.astro";
import ApiIntegrationFaq from "../../../components/api-integration/ApiIntegrationFaq.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "API & Integration",
  provider: {
    "@type": "Organization",
    name: "LKProfessionals",
  },
  areaServed: "Worldwide",
