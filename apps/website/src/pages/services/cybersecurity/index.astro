import CybersecurityOverview from "../../../components/cybersecurity/CybersecurityOverview.astro";
import CybersecurityServices from "../../../components/cybersecurity/CybersecurityServices.astro";
import CybersecurityPrinciples from "../../../components/cybersecurity/CybersecurityPrinciples.astro";
import CybersecurityApproach from "../../../components/cybersecurity/CybersecurityApproach.astro";
import CybersecurityRisks from "../../../components/cybersecurity/CybersecurityRisks.astro";
import CybersecurityFaq from "../../../components/cybersecurity/CybersecurityFaq.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Cybersecurity",
  provider: {
    "@type": "Organization",
    name: "LKProfessionals",
