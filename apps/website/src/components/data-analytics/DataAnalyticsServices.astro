---
import {
  analyticsServices,
} from "../../config/data-analytics";
---

<section class="da-services" aria-labelledby="da-services-title">
  <div class="site-container">
    <header class="da-services__heading">
      <div>
        <p>Data & analytics services</p>

        <h2 id="da-services-title">
          Different views of the same business reality.
        </h2>
      </div>

      <p>
        Each service solves a different part of the
        information and decision-making problem.
      </p>
    </header>

    <div class="da-services__list">
      {
        analyticsServices.map((service) => (
          <a href={service.href}>
            <span class="da-services__number">
              {service.number}
            </span>

            <div class="da-services__content">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>

            <div class="da-services__capabilities">
              {
                service.capabilities.map((item) => (
                  <span>{item}</span>
                ))
              }
            </div>

            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 18 18"
            >
              <path
                d="M3 9h12M11 5l4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .da-services {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .da-services__heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(15rem, .42fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .da-services__heading
    > div > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .da-services h2 {
    max-width: 14ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: 1;
  }

  .da-services__heading > p {
    margin: 0;
    color: #788497;
    font-size: .75rem;
    line-height: 1.7;
  }

  .da-services__list {
    border-top: 1px solid #dce3ec;
  }

  .da-services__list > a {
    display: grid;
    grid-template-columns:
      3rem
      minmax(13rem, .55fr)
      minmax(15rem, .65fr)
      auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1.5rem;
    transition:
      padding-inline 180ms ease,
      background-color 180ms ease;
  }

  .da-services__list > a:hover {
    padding-inline: .8rem;
    background: #ffffff;
  }

  .da-services__number {
    color: #0b2f8f;
    font-size: .6rem;
    font-weight: 800;
  }

  .da-services h3 {
    margin: 0;
    color: #263850;
    font-size: .9rem;
  }

  .da-services__content p {
    max-width: 35rem;
    margin: .45rem 0 0;
    color: #748095;
    font-size: .7rem;
    line-height: 1.65;
  }

  .da-services__capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }

  .da-services__capabilities span {
    border: 1px solid #d3dce7;
    border-radius: 999px;
    background: #ffffff;
    color: #657389;
    padding: .34rem .52rem;
    font-size: .54rem;
  }

  .da-services__list svg {
    color: #0b2f8f;
    transition: transform 180ms ease;
  }

  .da-services__list > a:hover svg {
    transform: translateX(.3rem);
  }

  @media (max-width: 56rem) {
    .da-services__list > a {
      grid-template-columns:
        2.5rem
        1fr
        auto;
    }

    .da-services__capabilities {
      grid-column: 2;
    }
  }

  @media (max-width: 48rem) {
    .da-services__heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 34rem) {
    .da-services__list > a {
      grid-template-columns:
        2rem
        1fr;
    }

    .da-services__list svg {
      display: none;
    }

    .da-services__capabilities {
      grid-column: 2;
    }
  }
</style>
