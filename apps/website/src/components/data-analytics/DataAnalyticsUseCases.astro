---
const useCases = [
  ["Sales", "Revenue, pipeline, conversion and customer activity."],
  ["Finance", "Income, expenses, cash movement and financial performance."],
  ["Operations", "Volumes, utilisation, delays, efficiency and exceptions."],
  ["Marketing", "Traffic, leads, acquisition and campaign performance."],
  ["Customer service", "Requests, response times, resolution and service trends."],
  ["Management", "Cross-functional executive visibility and organisational KPIs."],
];
---

<section class="da-usecases">
  <div class="site-container da-usecases__layout">
    <div>
      <p>Business visibility</p>

      <h2>
        Analytics should follow how the organisation operates.
      </h2>
    </div>

    <div class="da-usecases__list">
      {
        useCases.map(([title, description], index) => (
          <div>
            <span>
              {String(index + 1).padStart(2, "0")}
            </span>

            <strong>{title}</strong>

            <p>{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .da-usecases {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .da-usecases__layout {
    display: grid;
    grid-template-columns:
      minmax(16rem, .68fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .da-usecases__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .da-usecases h2 {
    max-width: 11ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: 1;
  }

  .da-usecases__list {
    border-top: 1px solid #dce3ec;
  }

  .da-usecases__list div {
    display: grid;
    grid-template-columns:
      3rem
      minmax(8rem, .3fr)
      1fr;
    gap: 1rem;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1rem;
  }

  .da-usecases__list span {
    color: #8792a2;
    font-size: .58rem;
    font-weight: 800;
  }

  .da-usecases__list strong {
    color: #293b53;
    font-size: .75rem;
  }

  .da-usecases__list p {
    margin: 0;
    color: #788497;
    font-size: .68rem;
    line-height: 1.6;
  }

  @media (max-width: 52rem) {
    .da-usecases__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .da-usecases__list div {
      grid-template-columns:
        2rem
        1fr;
    }

    .da-usecases__list p {
      grid-column: 2;
    }
  }
</style>
