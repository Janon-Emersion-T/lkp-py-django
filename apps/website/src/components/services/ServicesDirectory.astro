---
import {
  serviceFamilies,
} from "../../config/services";
---

<section
  class="services-directory"
  aria-labelledby="services-directory-title"
>
  <div class="site-container">
    <header class="services-directory__heading">
      <div>
        <p>Capability directory</p>

        <h2 id="services-directory-title">
          Find the part of the technology stack you need to change.
        </h2>
      </div>

      <p>
        The categories overlap deliberately. Real business problems
        rarely stay inside one technical discipline.
      </p>
    </header>

    <div class="services-directory__list">
      {
        serviceFamilies.map((service) => (
          <a href={service.href}>
            <span class="services-directory__number">
              {service.number}
            </span>

            <div class="services-directory__name">
              <small>{service.group}</small>
              <h3>{service.title}</h3>
            </div>

            <p class="services-directory__description">
              {service.description}
            </p>

            <div class="services-directory__focus">
              {
                service.focus.map((item) => (
                  <span>{item}</span>
                ))
              }
            </div>

            <svg
              aria-hidden="true"
              width="19"
              height="19"
              viewBox="0 0 19 19"
            >
              <path
                d="M3 9.5h13M12 5.5l4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-directory {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #ffffff;
  }

  .services-directory__heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(15rem, 0.38fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .services-directory__heading
    > div > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .services-directory__heading h2 {
    max-width: 14ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .services-directory__heading > p {
    margin: 0;
    color: #788497;
    font-size: 0.73rem;
    line-height: 1.7;
  }

  .services-directory__list {
    border-top: 1px solid #dce3ec;
  }

  .services-directory__list > a {
    display: grid;
    grid-template-columns:
      2.5rem
      minmax(10rem, 0.32fr)
      minmax(16rem, 0.7fr)
      minmax(13rem, 0.45fr)
      auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1.4rem;
    transition:
      background-color 180ms ease,
      padding-inline 180ms ease;
  }

  .services-directory__list > a:hover {
    padding-inline: 0.8rem;
    background: #f7f9fc;
  }

  .services-directory__number {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .services-directory__name small {
    display: block;
    margin-bottom: 0.35rem;
    color: #8a95a5;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .services-directory h3 {
    margin: 0;
    color: #25374f;
    font-size: 0.87rem;
  }

  .services-directory__description {
    max-width: 38rem;
    margin: 0;
    color: #748095;
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .services-directory__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .services-directory__focus span {
    border: 1px solid #d7dfe9;
    border-radius: 999px;
    color: #66758a;
    padding: 0.3rem 0.46rem;
    font-size: 0.5rem;
  }

  .services-directory svg {
    color: #0b2f8f;
    transition: transform 180ms ease;
  }

  .services-directory__list > a:hover svg {
    transform: translateX(0.3rem);
  }

  @media (max-width: 64rem) {
    .services-directory__list > a {
      grid-template-columns:
        2.5rem
        minmax(10rem, 0.35fr)
        1fr
        auto;
    }

    .services-directory__focus {
      grid-column: 3;
    }
  }

  @media (max-width: 50rem) {
    .services-directory__heading {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .services-directory__list > a {
      grid-template-columns:
        2rem
        1fr
        auto;
    }

    .services-directory__description,
    .services-directory__focus {
      grid-column: 2;
    }
  }

  @media (max-width: 34rem) {
    .services-directory__list > a {
      grid-template-columns:
        1.7rem
        1fr;
    }

    .services-directory__description,
    .services-directory__focus {
      grid-column: 2;
    }

    .services-directory svg {
      display: none;
    }
  }
</style>
