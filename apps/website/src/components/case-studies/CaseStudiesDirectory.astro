---
const apiBaseUrl =
  import.meta.env.PUBLIC_API_BASE_URL
  ?? "http://127.0.0.1:8082/api/v1";

const endpoint =
  `${apiBaseUrl}/case-studies/public`;
---

<section
  class="case-directory"
  data-case-study-directory
  data-endpoint={endpoint}
  aria-labelledby="case-directory-title"
>
  <div class="site-container">
    <header class="case-directory__heading">
      <div>
        <p>Published case studies</p>

        <h2 id="case-directory-title">
          One archive. Real published work.
        </h2>
      </div>

      <p>
        This directory loads all publicly published Case Studies
        directly from the LKProfessionals backend.
      </p>
    </header>

    <div
      class="case-directory__status"
      data-case-status
      role="status"
    >
      Loading published case studies…
    </div>

    <div
      class="case-directory__list"
      data-case-list
      hidden
    ></div>

    <div
      class="case-directory__empty"
      data-case-empty
      hidden
    >
      <span>Published archive</span>

      <h3>
        No public case studies have been published yet.
      </h3>

      <p>
        Case studies will appear here automatically once projects
        are completed, documented and published through the
        LKProfessionals dashboard.
      </p>
    </div>
  </div>
</section>

<template id="case-study-directory-template">
  <article class="case-entry">
    <span
      class="case-entry__index"
      data-index
    ></span>

    <div class="case-entry__main">
      <div class="case-entry__meta">
        <span data-client></span>
        <span data-industry></span>
        <span data-location></span>
      </div>

      <h3 data-title></h3>

      <p data-description></p>

      <div
        class="case-entry__services"
        data-services
      ></div>
    </div>

    <div
      class="case-entry__metrics"
      data-metrics
    ></div>

    <a
      class="case-entry__link"
      data-detail-link
      href="#"
    >
      <span>Read case study</span>

      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        width="19"
        height="19"
      >
        <path
          d="M3 10h14M12 5l5 5-5 5"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
        />
      </svg>
    </a>
  </article>
</template>

<script>
  interface CaseService {
    title?: string;
    slug?: string;
  }

  interface CaseMetric {
    label?: string;
    value?: string;
  }

  interface PublicCaseStudy {
    title?: string;
    slug?: string;
    client_name?: string;
    industry_name?: string;
    location?: string;
    short_description?: string;
    project_duration?: string;
    services?: CaseService[];
    metrics?: CaseMetric[];
  }

  interface PublicCaseResponse {
    count?: number;
    items?: PublicCaseStudy[];
  }

  document
    .querySelectorAll<HTMLElement>(
      "[data-case-study-directory]",
    )
    .forEach((root) => {
      const endpoint =
        root.dataset.endpoint;

      const status =
        root.querySelector<HTMLElement>(
          "[data-case-status]",
        );

      const list =
        root.querySelector<HTMLElement>(
          "[data-case-list]",
        );

      const empty =
        root.querySelector<HTMLElement>(
          "[data-case-empty]",
        );

      const template =
        document.querySelector<HTMLTemplateElement>(
          "#case-study-directory-template",
        );

      if (
        !endpoint
        || !status
        || !list
        || !empty
        || !template
      ) {
        return;
      }

      const setText = (
        parent: ParentNode,
        selector: string,
        value: string,
      ) => {
        const element =
          parent.querySelector<HTMLElement>(
            selector,
          );

        if (element) {
          element.textContent = value;
        }
      };

      const removeIfEmpty = (
        parent: ParentNode,
        selector: string,
        value?: string,
      ) => {
        const element =
          parent.querySelector<HTMLElement>(
            selector,
          );

        if (!element) {
          return;
        }

        if (value) {
          element.textContent = value;
        } else {
          element.remove();
        }
      };

      const render = (
        cases: PublicCaseStudy[],
      ) => {
        list.innerHTML = "";

        cases.forEach(
          (caseStudy, index) => {
            const fragment =
              template.content.cloneNode(
                true,
              ) as DocumentFragment;

            setText(
              fragment,
              "[data-index]",
              String(index + 1).padStart(
                2,
                "0",
              ),
            );

            setText(
              fragment,
              "[data-client]",
              caseStudy.client_name
                || "LKProfessionals project",
            );

            removeIfEmpty(
              fragment,
              "[data-industry]",
              caseStudy.industry_name,
            );

            removeIfEmpty(
              fragment,
              "[data-location]",
              caseStudy.location,
            );

            setText(
              fragment,
              "[data-title]",
              caseStudy.title
                || "Untitled case study",
            );

            setText(
              fragment,
              "[data-description]",
              caseStudy.short_description
                || "Project details are available in the full case study.",
            );

            const services =
              fragment.querySelector<HTMLElement>(
                "[data-services]",
              );

            if (services) {
              (
                caseStudy.services
                ?? []
              )
                .slice(0, 5)
                .forEach((service) => {
                  if (!service.title) {
                    return;
                  }

                  const item =
                    document.createElement(
                      "span",
                    );

                  item.textContent =
                    service.title;

                  services.appendChild(
                    item,
                  );
                });

              if (
                services.childElementCount === 0
              ) {
                services.remove();
              }
            }

            const metrics =
              fragment.querySelector<HTMLElement>(
                "[data-metrics]",
              );

            if (metrics) {
              (
                caseStudy.metrics
                ?? []
              )
                .slice(0, 2)
                .forEach((metric) => {
                  if (
                    !metric.label
                    && !metric.value
                  ) {
                    return;
                  }

                  const item =
                    document.createElement(
                      "div",
                    );

                  const value =
                    document.createElement(
                      "strong",
                    );

                  const label =
                    document.createElement(
                      "span",
                    );

                  value.textContent =
                    metric.value ?? "";

                  label.textContent =
                    metric.label ?? "";

                  item.append(
                    value,
                    label,
                  );

                  metrics.appendChild(
                    item,
                  );
                });

              if (
                caseStudy.project_duration
                && metrics.childElementCount < 2
              ) {
                const item =
                  document.createElement(
                    "div",
                  );

                const value =
                  document.createElement(
                    "strong",
                  );

                const label =
                  document.createElement(
                    "span",
                  );

                value.textContent =
                  caseStudy.project_duration;

                label.textContent =
                  "Project duration";

                item.append(
                  value,
                  label,
                );

                metrics.appendChild(
                  item,
                );
              }

              if (
                metrics.childElementCount === 0
              ) {
                metrics.remove();
              }
            }

            const link =
              fragment.querySelector<HTMLAnchorElement>(
                "[data-detail-link]",
              );

            if (
              link
              && caseStudy.slug
            ) {
              link.href =
                `/case-studies/${caseStudy.slug}/`;

              link.setAttribute(
                "aria-label",
                `Read ${caseStudy.title ?? "case study"}`,
              );
            } else if (link) {
              link.remove();
            }

            list.appendChild(
              fragment,
            );
          },
        );
      };

      fetch(endpoint, {
        headers: {
          Accept: "application/json",
        },
      })
        .then(async (response) => {
          if (!response.ok) {
            throw new Error(
              `HTTP ${response.status}`,
            );
          }

          return (
            await response.json()
          ) as PublicCaseResponse;
        })
        .then((payload) => {
          const cases =
            Array.isArray(
              payload.items,
            )
              ? payload.items
              : [];

          status.hidden = true;

          if (
            cases.length === 0
          ) {
            list.hidden = true;
            empty.hidden = false;
            return;
          }

          render(cases);

          empty.hidden = true;
          list.hidden = false;
        })
        .catch(() => {
          status.textContent =
            "Published case studies are temporarily unavailable. Please try again shortly.";
        });
    });
</script>

<style>
  .case-directory {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #f6f8fb;
  }

  .case-directory__heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(15rem, 0.38fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .case-directory__heading
    > div > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-directory h2 {
    max-width: 11ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .case-directory__heading > p {
    margin: 0;
    color: #788497;
    font-size: 0.73rem;
    line-height: 1.7;
  }

  .case-directory__status {
    border-top: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    color: #748095;
    padding-block: 1.5rem;
    font-size: 0.7rem;
  }

  .case-directory__list {
    border-top: 1px solid #dce3ec;
  }

  :global(.case-entry) {
    display: grid;
    grid-template-columns:
      2.5rem
      minmax(0, 1fr)
      minmax(11rem, 0.32fr)
      auto;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: start;
    border-bottom: 1px solid #dce3ec;
    padding-block: 2rem;
  }

  :global(.case-entry__index) {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
  }

  :global(.case-entry__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 0.65rem;
    color: #8a95a5;
    font-size: 0.53rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.case-entry__meta span + span::before) {
    margin-right: 0.7rem;
    content: "·";
  }

  :global(.case-entry h3) {
    max-width: 17ch;
    margin: 0;
    color: #263850;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  :global(.case-entry__main > p) {
    max-width: 43rem;
    margin: 0.8rem 0 0;
    color: #748095;
    font-size: 0.7rem;
    line-height: 1.7;
  }

  :global(.case-entry__services) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  :global(.case-entry__services span) {
    border: 1px solid #d2dbe6;
    border-radius: 999px;
    background: #ffffff;
    color: #66758a;
    padding: 0.31rem 0.48rem;
    font-size: 0.5rem;
  }

  :global(.case-entry__metrics) {
    display: grid;
    gap: 1rem;
  }

  :global(.case-entry__metrics div) {
    border-left: 1px solid #d4dce7;
    padding-left: 0.8rem;
  }

  :global(.case-entry__metrics strong) {
    display: block;
    color: #0b2f8f;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
  }

  :global(.case-entry__metrics span) {
    display: block;
    color: #8792a2;
    margin-top: 0.1rem;
    font-size: 0.52rem;
  }

  :global(.case-entry__link) {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #0b2f8f;
    font-size: 0.62rem;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.case-entry__link svg) {
    transition: transform 180ms ease;
  }

  :global(.case-entry__link:hover svg) {
    transform: translateX(0.3rem);
  }

  .case-directory__empty {
    max-width: 48rem;
    border-top: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .case-directory__empty > span {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-directory__empty h3 {
    max-width: 13ch;
    margin: 0.8rem 0 0;
    color: #263850;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .case-directory__empty p {
    max-width: 39rem;
    margin: 1rem 0 0;
    color: #788497;
    font-size: 0.72rem;
    line-height: 1.75;
  }

  @media (max-width: 56rem) {
    :global(.case-entry) {
      grid-template-columns:
        2rem
        1fr
        auto;
    }

    :global(.case-entry__metrics) {
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
    }
  }

  @media (max-width: 48rem) {
    .case-directory__heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 38rem) {
    :global(.case-entry) {
      grid-template-columns:
        1.6rem
        1fr;
    }

    :global(.case-entry__metrics),
    :global(.case-entry__link) {
      grid-column: 2;
    }
  }
</style>
