---
import {
  getPortfolioProjects,
} from "../../lib/portfolio/api";

const caseStudies =
  await getPortfolioProjects();

const visibleCaseStudies =
  caseStudies.filter(
    (caseStudy) =>
      caseStudy
      && caseStudy.slug
      && caseStudy.title,
  );
---

<section
  class="case-directory"
  aria-labelledby="case-directory-title"
>
  <div class="site-container">
    <header class="case-directory__heading">
      <div>
        <p>Published case studies</p>

        <h2 id="case-directory-title">
          One archive. Real published work.
        </h2>
      </div>

      <p>
        Explore publicly published LKProfessionals
        projects, delivery work and measurable outcomes.
      </p>
    </header>

    {
      visibleCaseStudies.length > 0 ? (
        <div class="case-directory__list">
          {
            visibleCaseStudies.map(
              (caseStudy, index) => {
                const services =
                  Array.isArray(caseStudy.services)
                    ? caseStudy.services
                    : [];

                const metrics =
                  Array.isArray(caseStudy.metrics)
                    ? caseStudy.metrics.slice(0, 2)
                    : [];

                const showDuration =
                  Boolean(
                    caseStudy.project_duration
                  )
                  && metrics.length < 2;

                return (
                  <article class="case-entry">
                    <span class="case-entry__index">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <div class="case-entry__main">
                      <div class="case-entry__meta">
                        {
                          caseStudy.client_name && (
                            <span>
                              {caseStudy.client_name}
                            </span>
                          )
                        }

                        {
                          caseStudy.industry_name && (
                            <span>
                              {caseStudy.industry_name}
                            </span>
                          )
                        }

                        {
                          caseStudy.location && (
                            <span>
                              {caseStudy.location}
                            </span>
                          )
                        }
                      </div>

                      <h3>{caseStudy.title}</h3>

                      {
                        caseStudy.short_description && (
                          <p>
                            {caseStudy.short_description}
                          </p>
                        )
                      }

                      {
                        services.length > 0 && (
                          <div class="case-entry__services">
                            {
                              services.map(
                                (service) => (
                                  <span>
                                    {service.title}
                                  </span>
                                ),
                              )
                            }
                          </div>
                        )
                      }
                    </div>

                    {
                      (
                        metrics.length > 0
                        || showDuration
                      ) && (
                        <div class="case-entry__metrics">
                          {
                            metrics.map(
                              (metric) => (
                                <div>
                                  <strong>
                                    {metric.value}
                                  </strong>

                                  <span>
                                    {metric.label}
                                  </span>
                                </div>
                              ),
                            )
                          }

                          {
                            showDuration && (
                              <div>
                                <strong>
                                  {
                                    caseStudy
                                      .project_duration
                                  }
                                </strong>

                                <span>
                                  Project duration
                                </span>
                              </div>
                            )
                          }
                        </div>
                      )
                    }

                    <a
                      class="case-entry__link"
                      href={`/case-studies/${caseStudy.slug}/`}
                      aria-label={`Read ${caseStudy.title}`}
                    >
                      <span>
                        Read case study
                      </span>

                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        width="19"
                        height="19"
                      >
                        <path
                          d="M3 10h14M12 5l5 5-5 5"
                          fill="none"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                        />
                      </svg>
                    </a>
                  </article>
                );
              },
            )
          }
        </div>
      ) : (
        <div class="case-directory__empty">
          <span>Published archive</span>

          <h3>
            No public case studies have been
            published yet.
          </h3>

          <p>
            Case studies will appear here after
            projects are completed, documented and
            published through the LKProfessionals
            dashboard.
          </p>
        </div>
      )
    }
  </div>
</section>
<style>
  .case-directory {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #f6f8fb;
  }

  .case-directory__heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(15rem, 0.38fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .case-directory__heading
    > div > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .case-directory h2 {
    max-width: 11ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .case-directory__heading > p {
    margin: 0;
    color: #788497;
    font-size: 0.73rem;
    line-height: 1.7;
  }

  .case-directory__status {
    border-top: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    color: #748095;
    padding-block: 1.5rem;
    font-size: 0.7rem;
  }

  .case-directory__list {
    border-top: 1px solid #dce3ec;
  }

  :global(.case-entry) {
    display: grid;
    grid-template-columns:
      2.5rem
      minmax(0, 1fr)
      minmax(11rem, 0.32fr)
      auto;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: start;
    border-bottom: 1px solid #dce3ec;
    padding-block: 2rem;
  }

  :global(.case-entry__index) {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
  }

  :global(.case-entry__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 0.65rem;
    color: #8a95a5;
    font-size: 0.53rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.case-entry__meta span + span::before) {
    margin-right: 0.7rem;
    content: "·";
  }

  :global(.case-entry h3) {
    max-width: 17ch;
    margin: 0;
    color: #263850;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  :global(.case-entry__main > p) {
    max-width: 43rem;
    margin: 0.8rem 0 0;
    color: #748095;
    font-size: 0.7rem;
    line-height: 1.7;
  }

  .case-entry__services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .case-entry__services span {
    border: 1px solid #d2dbe6;
    border-radius: 999px;
    background: #ffffff;
    color: #66758a;
    padding: 0.31rem 0.48rem;
    font-size: 0.5rem;
  }

  .case-entry__metrics {
    display: grid;
    gap: 1rem;
  }

  .case-entry__metrics div {
    border-left: 1px solid #d4dce7;
    padding-left: 0.8rem;
  }

  .case-entry__metrics strong {
    display: block;
    color: #0b2f8f;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .case-entry__metrics span {
    display: block;
    color: #8792a2;
    margin-top: 0.1rem;
    font-size: 0.52rem;
  }

  :global(.case-entry__link) {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #0b2f8f;
    font-size: 0.62rem;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.case-entry__link svg) {
    transition: transform 180ms ease;
  }

  :global(.case-entry__link:hover svg) {
    transform: translateX(0.3rem);
  }

  .case-directory__empty {
    max-width: 48rem;
    border-top: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .case-directory__empty > span {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-directory__empty h3 {
    max-width: 13ch;
    margin: 0.8rem 0 0;
    color: #263850;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .case-directory__empty p {
    max-width: 39rem;
    margin: 1rem 0 0;
    color: #788497;
    font-size: 0.72rem;
    line-height: 1.75;
  }

  @media (max-width: 56rem) {
    :global(.case-entry) {
      grid-template-columns:
        2rem
        1fr
        auto;
    }

    .case-entry__metrics {
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
    }
  }

  @media (max-width: 48rem) {
    .case-directory__heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 38rem) {
    :global(.case-entry) {
      grid-template-columns:
        1.6rem
        1fr;
    }

    .case-entry__metrics,
    :global(.case-entry__link) {
      grid-column: 2;
    }
  }
</style>