---
const risks = [
  [
    "Outdated software",
    "Unmaintained dependencies and platforms can preserve known vulnerabilities.",
  ],
  [
    "Excessive access",
    "Users, services and applications may retain permissions they no longer require.",
  ],
  [
    "Weak recovery",
    "Backups that cannot be restored are not a dependable recovery strategy.",
  ],
  [
    "Misconfiguration",
    "Security issues frequently come from incorrect settings rather than sophisticated attacks.",
  ],
  [
    "Forgotten exposure",
    "Unused services, test systems and old endpoints can remain reachable long after their purpose ends.",
  ],
  [
    "Missing visibility",
    "Incidents are harder to understand when logs, ownership and system state are unclear.",
  ],
];
---

<section class="security-risks">
  <div class="site-container security-risks__layout">
    <div>
      <p>Common security gaps</p>

      <h2>
        Risk often accumulates quietly.
      </h2>
    </div>

    <div class="security-risks__list">
      {
        risks.map(([title, description], index) => (
          <article>
            <span>
              {String(index + 1).padStart(2, "0")}
            </span>

            <strong>{title}</strong>

            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .security-risks {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .security-risks__layout {
    display: grid;
    grid-template-columns:
      minmax(16rem, 0.68fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .security-risks__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .security-risks h2 {
    max-width: 10ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .security-risks__list {
    border-top: 1px solid #dce3ec;
  }

  .security-risks article {
    display: grid;
    grid-template-columns:
      3rem
      minmax(8rem, 0.3fr)
      1fr;
    gap: 1rem;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1rem;
  }

  .security-risks article > span {
    color: #8792a2;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .security-risks article > strong {
    color: #293b53;
    font-size: 0.75rem;
  }

  .security-risks article > p {
    margin: 0;
    color: #788497;
    font-size: 0.68rem;
    line-height: 1.6;
  }

  @media (max-width: 52rem) {
    .security-risks__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .security-risks article {
      grid-template-columns:
        2rem
        1fr;
    }

    .security-risks article > p {
      grid-column: 2;
    }
  }
</style>
