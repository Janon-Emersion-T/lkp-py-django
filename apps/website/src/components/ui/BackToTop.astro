<button
  class="back-to-top"
  type="button"
  aria-label="Back to top"
  title="Back to top"
  data-back-to-top
>
  <span class="back-to-top__label" aria-hidden="true">
    Top
  </span>

  <span class="back-to-top__icon" aria-hidden="true">
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
    >
      <path
        d="M4.5 10.5 9 6l4.5 4.5"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</button>

<script>
  const backToTopButton = document.querySelector<HTMLButtonElement>(
    "[data-back-to-top]",
  );

  if (backToTopButton) {
    const revealThreshold = 520;
    let ticking = false;

    const updateVisibility = () => {
      const shouldShow = window.scrollY >= revealThreshold;

      backToTopButton.toggleAttribute(
        "data-visible",
        shouldShow,
      );

      ticking = false;
    };

    const requestVisibilityUpdate = () => {
      if (ticking) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(updateVisibility);
    };

    window.addEventListener(
      "scroll",
      requestVisibilityUpdate,
      {
        passive: true,
      },
    );

    updateVisibility();

    backToTopButton.addEventListener("click", () => {
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? "auto" : "smooth",
      });
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 2vw, 1.5rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    z-index: 80;

    display: inline-flex;
    min-width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;

    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.7rem;

    background: #0b2f8f;
    color: #ffffff;

    box-shadow:
      0 9px 24px rgba(7, 31, 101, 0.18),
      0 2px 6px rgba(7, 31, 101, 0.12);

    cursor: pointer;

    padding-inline: 0.85rem;

    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    opacity: 0;
    visibility: hidden;

    transform: translateY(0.75rem);

    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background: #1746c7;
    box-shadow:
      0 12px 28px rgba(7, 31, 101, 0.24),
      0 3px 8px rgba(7, 31, 101, 0.14);
  }

  .back-to-top:focus-visible {
    outline: 3px solid rgba(23, 70, 199, 0.28);
    outline-offset: 4px;
  }

  .back-to-top__label {
    line-height: 1;
  }

  .back-to-top__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    align-items: center;
    justify-content: center;

    transition: transform 180ms ease;
  }

  .back-to-top:hover .back-to-top__icon {
    transform: translateY(-2px);
  }

  @media (max-width: 40rem) {
    .back-to-top {
      width: 2.85rem;
      min-width: 2.85rem;
      height: 2.85rem;
      border-radius: 0.65rem;
      padding: 0;
    }

    .back-to-top__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .back-to-top__icon {
      width: 1.15rem;
      height: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top__icon {
      transition: none;
    }
  }
</style>
