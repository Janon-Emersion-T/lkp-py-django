---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "split";
}

const {
  eyebrow,
  title,
  description,
  align = "left",
} = Astro.props;
---

<header class:list={["section-heading-block", `section-heading-block--${align}`]}>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-heading">{title}</h2>
  </div>

  {
    description && (
      <p class="section-heading-block__description">
        {description}
      </p>
    )
  }
</header>

<style>
  .section-heading-block {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.75rem);
  }

  .section-heading-block--split {
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 7rem);
  }

  .eyebrow {
    margin: 0 0 1.2rem;
  }

  .section-heading-block__description {
    max-width: 34rem;
    margin: 0;
    color: var(--colour-muted);
    font-size: 1.05rem;
    line-height: 1.72;
  }

  @media (max-width: 50rem) {
    .section-heading-block--split {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
