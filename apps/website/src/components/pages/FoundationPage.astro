---
import {
  sitePageByPath,
  type SitePage,
} from "../../content/site-pages";
import {
  getFoundationPageContent,
} from "../../content/foundation-page-content";
import Container from "../ui/Container.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import TextLink from "../ui/TextLink.astro";

interface Props {
  page: SitePage;
}

const { page } = Astro.props;

const parent = page.parentPath
  ? sitePageByPath.get(page.parentPath)
  : null;

const children = page.childPaths
  .map((path) => sitePageByPath.get(path))
  .filter((item): item is SitePage => Boolean(item));

const content = getFoundationPageContent(page);
---

<article class="foundation-page">
  <Container>
    <nav class="foundation-page__breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>

      {
        parent && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/${parent.path}/`}>{parent.title}</a>
          </>
        )
      }

      <span aria-hidden="true">/</span>
      <span aria-current="page">{page.title}</span>
    </nav>

    <div class="foundation-page__content">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.lead}</p>
    </div>

    <div class="foundation-page__overview">
      {
        content.overview.map((item) => (
          <p>{item}</p>
        ))
      }
    </div>

    <section
      class="foundation-page__highlights"
      aria-labelledby="foundation-page-highlights-title"
    >
      <div class="foundation-page__section-intro">
        <p class="eyebrow">What to expect</p>
        <h2 id="foundation-page-highlights-title">
          A more useful page structure for {page.title}
        </h2>
      </div>

      <div class="foundation-page__highlight-grid">
        {
          content.highlights.map((group) => (
            <section class="foundation-page__panel">
              <h3>{group.title}</h3>

              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section
      class="foundation-page__sections"
      aria-labelledby="foundation-page-sections-title"
    >
      <div class="foundation-page__section-intro">
        <p class="eyebrow">Page content</p>
        <h2 id="foundation-page-sections-title">
          Route-specific context instead of placeholder copy
        </h2>
      </div>

      <div class="foundation-page__section-grid">
        {
          content.sections.map((section) => (
            <article class="foundation-page__section-card">
              <h3>{section.title}</h3>
              <p>{section.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="foundation-page__cta" aria-labelledby="foundation-page-cta-title">
      <div class="foundation-page__cta-copy">
        <p class="eyebrow">{content.contextLabel}</p>
        <h2 id="foundation-page-cta-title">{content.cta.title}</h2>
        <p>{content.cta.body}</p>
      </div>

      <div class="foundation-page__cta-actions">
        <ButtonLink
          href={content.cta.primaryHref}
          label={content.cta.primaryLabel}
        />

        {
          content.cta.secondaryHref
            && content.cta.secondaryLabel && (
              <TextLink
                href={content.cta.secondaryHref}
                label={content.cta.secondaryLabel}
              />
            )
        }
      </div>
    </section>

    {
      children.length > 0 && (
        <section
          class="foundation-page__children"
          aria-labelledby="foundation-page-children-title"
        >
          <h2 id="foundation-page-children-title">
            Explore {page.title}
          </h2>

          <div class="foundation-page__links">
            {
              children.map((child, index) => (
                <a href={`/${child.path}/`}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{child.title}</strong>
                  <svg
                    aria-hidden="true"
                    width="17"
                    height="17"
                    viewBox="0 0 17 17"
                  >
                    <path
                      d="M3 8.5h11M10 4.5l4 4-4 4"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                    />
                  </svg>
                </a>
              ))
            }
          </div>
        </section>
      )
    }
  </Container>
</article>

<style>
  .foundation-page {
    min-height: 46rem;
    padding-block: clamp(3rem, 7vw, 7rem) clamp(5rem, 10vw, 9rem);
    background: var(--colour-paper);
  }

  .foundation-page__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--colour-muted);
    font-size: 0.76rem;
    font-weight: 650;
  }

  .foundation-page__breadcrumbs a:hover {
    color: var(--colour-accent-dark);
  }

  .foundation-page__content {
    display: grid;
    max-width: 58rem;
    gap: 1.5rem;
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .foundation-page h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(3.3rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .foundation-page__content > p:last-child {
    max-width: 44rem;
    margin: 0;
    color: var(--colour-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.28rem);
    line-height: 1.7;
  }

  .foundation-page__overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem 2rem;
    margin-top: 2.5rem;
  }

  .foundation-page__overview p {
    margin: 0;
    color: var(--colour-muted);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .foundation-page__highlights,
  .foundation-page__sections,
  .foundation-page__cta,
  .foundation-page__children {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .foundation-page__section-intro {
    display: grid;
    max-width: 42rem;
    gap: 1rem;
  }

  .foundation-page__section-intro h2,
  .foundation-page__cta h2,
  .foundation-page__children h2 {
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.02;
  }

  .foundation-page__highlight-grid,
  .foundation-page__section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 2.3rem;
  }

  .foundation-page__panel,
  .foundation-page__section-card,
  .foundation-page__cta {
    border: 1px solid var(--colour-line);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14px);
  }

  .foundation-page__panel,
  .foundation-page__section-card {
    padding: 1.6rem;
  }

  .foundation-page__panel h3,
  .foundation-page__section-card h3 {
    margin: 0 0 0.9rem;
    color: var(--colour-ink-strong);
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .foundation-page__panel ul {
    margin: 0;
    padding-left: 1rem;
    color: var(--colour-muted);
  }

  .foundation-page__panel li + li {
    margin-top: 0.7rem;
  }

  .foundation-page__section-card p {
    margin: 0;
    color: var(--colour-muted);
    line-height: 1.8;
  }

  .foundation-page__cta {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.8rem, 4vw, 3rem);
  }

  .foundation-page__cta-copy {
    display: grid;
    gap: 1rem;
  }

  .foundation-page__cta-copy p:last-child {
    margin: 0;
    color: var(--colour-muted);
    line-height: 1.8;
  }

  .foundation-page__cta-actions {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .foundation-page__children h2 {
    margin-bottom: 2rem;
  }

  .foundation-page__links {
    border-top: 1px solid var(--colour-line);
  }

  .foundation-page__links a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--colour-line);
    padding-block: 1.25rem;
    transition:
      padding-inline 160ms ease,
      background-color 160ms ease;
  }

  .foundation-page__links a:hover {
    padding-inline: 1rem;
    background: var(--colour-white);
  }

  .foundation-page__links span {
    color: var(--colour-accent-dark);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .foundation-page__links strong {
    color: var(--colour-ink-strong);
    font-size: 1rem;
  }

  .foundation-page__links svg {
    transition: transform 160ms ease;
  }

  .foundation-page__links a:hover svg {
    transform: translateX(0.25rem);
  }

  @media (max-width: 56rem) {
    .foundation-page__overview,
    .foundation-page__highlight-grid,
    .foundation-page__section-grid,
    .foundation-page__cta {
      grid-template-columns: 1fr;
    }
  }
</style>
