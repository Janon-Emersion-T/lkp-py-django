---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const {
  eyebrow = "Resources",
  title,
  description,
} = Astro.props;
---

<section class="resources-hero">
  <div class="site-container resources-hero__layout">
    <div>
      <p class="resources-hero__eyebrow">
        {eyebrow}
      </p>

      <h1>{title}</h1>
    </div>

    <div class="resources-hero__context">
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  .resources-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #dde4ed;
    background: #f7f9fc;
    padding-block:
      clamp(5rem, 10vw, 9rem)
      clamp(3.5rem, 7vw, 5rem);
  }

  .resources-hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(11, 47, 143, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        rgba(11, 47, 143, 0.035) 1px,
        transparent 1px
      );
    background-size: 4.5rem 4.5rem;
    content: "";
    pointer-events: none;
  }

  .resources-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(17rem, 0.42fr);
    gap: clamp(3rem, 9vw, 8rem);
    align-items: end;
  }

  .resources-hero__eyebrow {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .resources-hero h1 {
    max-width: 11ch;
    margin: 0;
    color: #0b1e3a;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 8vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .resources-hero__context {
    border-left: 1px solid #cdd6e2;
    padding-left: 1.4rem;
  }

  .resources-hero__context p {
    margin: 0;
    color: #6d798b;
    font-size: 0.78rem;
    line-height: 1.8;
  }

  @media (max-width: 52rem) {
    .resources-hero__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
