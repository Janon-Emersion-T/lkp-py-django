---
import type {
  PublicResource,
} from "../../lib/resources/types";

interface Props {
  resources: PublicResource[];
}

const { resources } = Astro.props;

const labelForType = (
  type: PublicResource["resource_type"],
) => {
  const labels = {
    download: "Download",
    guide: "Guide",
    checklist: "Checklist",
    template: "Template",
  };

  return labels[type];
};
---

<section class="resources-list">
  <div class="site-container">
    {
      resources.length > 0 ? (
        <div class="resources-list__items">
          {
            resources.map((resource, index) => (
              <article class="resource-entry">
                <span class="resource-entry__number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="resource-entry__main">
                  <div class="resource-entry__meta">
                    <span>
                      {labelForType(resource.resource_type)}
                    </span>

                    {
                      resource.download_count !== undefined && (
                        <span>
                          {resource.download_count}
                          {" "}downloads
                        </span>
                      )
                    }
                  </div>

                  <h2>
                    <a href={`/resources/${resource.slug}/`}>
                      {resource.title}
                    </a>
                  </h2>
                </div>

                <div class="resource-entry__summary">
                  {
                    resource.excerpt && (
                      <p>{resource.excerpt}</p>
                    )
                  }

                  <a href={`/resources/${resource.slug}/`}>
                    View resource
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      ) : (
        <div class="resources-list__empty">
          <p>
            No resources have been published yet.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .resources-list {
    background: #fff;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .resources-list__items {
    border-top: 1px solid #d8e0e9;
  }

  .resource-entry {
    display: grid;
    grid-template-columns:
      3rem
      minmax(15rem, 0.85fr)
      minmax(15rem, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid #d8e0e9;
    padding-block: clamp(2.2rem, 4vw, 3.4rem);
  }

  .resource-entry__number {
    color: #8b97a7;
    font-family: var(--font-serif);
  }

  .resource-entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
    margin-bottom: 0.9rem;
    color: #0b2f8f;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .resource-entry h2 {
    max-width: 18ch;
    margin: 0;
    color: #0b1e3a;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .resource-entry h2 a:hover {
    color: #0b2f8f;
  }

  .resource-entry__summary p {
    max-width: 39rem;
    margin: 0;
    color: #6d798b;
    font-size: 0.78rem;
    line-height: 1.85;
  }

  .resource-entry__summary > a {
    display: inline-flex;
    gap: 0.55rem;
    border-bottom: 1px solid #0b2f8f;
    margin-top: 1.4rem;
    padding-bottom: 0.15rem;
    color: #0b2f8f;
    font-size: 0.72rem;
    font-weight: 750;
  }

  .resources-list__empty {
    border-block: 1px solid #d8e0e9;
    padding-block: 2rem;
    color: #758195;
  }

  @media (max-width: 50rem) {
    .resource-entry {
      grid-template-columns: 2rem 1fr;
    }

    .resource-entry__summary {
      grid-column: 2;
    }
  }

  @media (max-width: 34rem) {
    .resource-entry {
      grid-template-columns: 1fr;
    }

    .resource-entry__number {
      display: none;
    }

    .resource-entry__summary {
      grid-column: auto;
    }
  }
</style>
