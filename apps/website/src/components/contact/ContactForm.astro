---
const apiBaseUrl =
  import.meta.env.PUBLIC_API_BASE_URL
  ?? "http://127.0.0.1:8082/api/v1";
---

<section class="contact-form-section" aria-labelledby="contact-form-title">
  <div class="site-container contact-form-section__layout">
    <div class="contact-form-section__intro">
      <p class="eyebrow">Send an enquiry</p>

      <h2 id="contact-form-title">
        Tell us how we can help.
      </h2>

      <p>
        Send us a short overview and the right member of our team
        will follow up.
      </p>

      <div class="contact-form-section__note">
        <span>Typical response</span>
        <strong>Within one business day</strong>
      </div>
    </div>

    <form
      class="contact-form"
      data-contact-form
      data-endpoint={`${apiBaseUrl}/enquiries/contacts/public`}
      novalidate
    >
      <div class="contact-form__grid">
        <div class="contact-field">
          <label for="contact-name">
            Full Name
            <span>*</span>
          </label>

          <input
            id="contact-name"
            name="full_name"
            type="text"
            autocomplete="name"
            maxlength="200"
            required
          />

          <p data-error-for="full_name"></p>
        </div>

        <div class="contact-field">
          <label for="contact-company">
            Company
          </label>

          <input
            id="contact-company"
            name="company_name"
            type="text"
            autocomplete="organization"
            maxlength="200"
          />

          <p data-error-for="company_name"></p>
        </div>

        <div class="contact-field">
          <label for="contact-email">
            Email Address
            <span>*</span>
          </label>

          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
          />

          <p data-error-for="email"></p>
        </div>

        <div class="contact-field">
          <label for="contact-phone">
            Phone / WhatsApp
          </label>

          <input
            id="contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            maxlength="50"
            placeholder="+94..."
          />

          <p data-error-for="phone"></p>
        </div>

        <div class="contact-field contact-field--full">
          <label for="contact-subject">
            Subject
            <span>*</span>
          </label>

          <input
            id="contact-subject"
            name="subject"
            type="text"
            maxlength="250"
            required
          />

          <p data-error-for="subject"></p>
        </div>

        <div class="contact-field contact-field--full">
          <label for="contact-message">
            Message
            <span>*</span>
          </label>

          <textarea
            id="contact-message"
            name="message"
            rows="7"
            maxlength="5000"
            placeholder="Tell us briefly what you would like to discuss."
            required
          ></textarea>

          <p data-error-for="message"></p>
        </div>
      </div>

      <div
        class="contact-form__status"
        data-contact-status
        role="status"
        aria-live="polite"
      ></div>

      <div class="contact-form__footer">
        <p>
          Your information is used only to respond to your enquiry.
        </p>

        <button type="submit" data-contact-submit>
          <span data-submit-label>Send Enquiry</span>

          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 16 16"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const initialiseContactForm = () => {
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-contact-form]",
      );

    if (
      !form
      || form.dataset.initialised === "true"
    ) {
      return;
    }

    form.dataset.initialised = "true";

    const status =
      form.querySelector<HTMLElement>(
        "[data-contact-status]",
      );

    const submit =
      form.querySelector<HTMLButtonElement>(
        "[data-contact-submit]",
      );

    const submitLabel =
      form.querySelector<HTMLElement>(
        "[data-submit-label]",
      );

    const clearErrors = () => {
      form
        .querySelectorAll<HTMLElement>(
          "[data-error-for]",
        )
        .forEach((element) => {
          element.textContent = "";
        });

      form
        .querySelectorAll(
          ".contact-field--invalid",
        )
        .forEach((element) => {
          element.classList.remove(
            "contact-field--invalid",
          );
        });
    };

    const setError = (
      field: string,
      message: string,
    ) => {
      const error =
        form.querySelector<HTMLElement>(
          `[data-error-for="${field}"]`,
        );

      const input =
        form.querySelector<HTMLElement>(
          `[name="${field}"]`,
        );

      error && (error.textContent = message);

      input
        ?.closest(".contact-field")
        ?.classList.add(
          "contact-field--invalid",
        );
    };

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        clearErrors();

        if (status) {
          status.textContent = "";
          status.className =
            "contact-form__status";
        }

        const data = new FormData(form);

        const payload = {
          full_name:
            String(
              data.get("full_name") ?? "",
            ).trim(),

          company_name:
            String(
              data.get("company_name") ?? "",
            ).trim(),

          email:
            String(
              data.get("email") ?? "",
            ).trim(),

          phone:
            String(
              data.get("phone") ?? "",
            ).trim(),

          subject:
            String(
              data.get("subject") ?? "",
            ).trim(),

          message:
            String(
              data.get("message") ?? "",
            ).trim(),

          source_url:
            window.location.href,
        };

        if (!payload.full_name) {
          setError(
            "full_name",
            "Enter your full name.",
          );
        }

        const email =
          form.querySelector<HTMLInputElement>(
            '[name="email"]',
          );

        if (
          !payload.email
          || !email?.checkValidity()
        ) {
          setError(
            "email",
            "Enter a valid email address.",
          );
        }

        if (!payload.subject) {
          setError(
            "subject",
            "Enter a subject.",
          );
        }

        if (!payload.message) {
          setError(
            "message",
            "Enter your message.",
          );
        }

        const invalid =
          form.querySelector<HTMLElement>(
            ".contact-field--invalid "
            + "input, "
            + ".contact-field--invalid "
            + "textarea",
          );

        if (invalid) {
          invalid.focus();
          return;
        }

        submit?.setAttribute(
          "disabled",
          "",
        );

        submit?.setAttribute(
          "aria-busy",
          "true",
        );

        if (submitLabel) {
          submitLabel.textContent =
            "Sending…";
        }

        try {
          const response =
            await fetch(
              form.dataset.endpoint ?? "",
              {
                method: "POST",
                headers: {
                  "Content-Type":
                    "application/json",
                },
                body: JSON.stringify(
                  payload,
                ),
              },
            );

          const result =
            await response
              .json()
              .catch(() => null);

          if (!response.ok) {
            throw new Error(
              result?.message
              ?? "We could not send your enquiry.",
            );
          }

          form.reset();

          if (status) {
            status.textContent =
              `Thank you. Your enquiry has been received. Reference: ${result.reference_code}`;

            status.classList.add(
              "contact-form__status--success",
            );
          }
        } catch (error) {
          if (status) {
            status.textContent =
              error instanceof Error
                ? error.message
                : "We could not send your enquiry.";

            status.classList.add(
              "contact-form__status--error",
            );
          }
        } finally {
          submit?.removeAttribute(
            "disabled",
          );

          submit?.removeAttribute(
            "aria-busy",
          );

          if (submitLabel) {
            submitLabel.textContent =
              "Send Enquiry";
          }
        }
      },
    );
  };

  if (
    document.readyState === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseContactForm,
      {
        once: true,
      },
    );
  } else {
    initialiseContactForm();
  }

  document.addEventListener(
    "astro:page-load",
    initialiseContactForm,
  );
</script>

<style>
  .contact-form-section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .contact-form-section__layout {
    display: grid;
    grid-template-columns:
      minmax(15rem, 0.68fr)
      minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .contact-form-section__intro {
    position: sticky;
    top: 7rem;
  }

  .contact-form-section__intro h2 {
    max-width: 10ch;
    margin: 1rem 0 0;
    color: #0c1e39;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .contact-form-section__intro > p:last-of-type {
    max-width: 28rem;
    margin: 1.25rem 0 0;
    color: #6c788b;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .contact-form-section__note {
    display: grid;
    gap: 0.2rem;
    border-top: 1px solid #dce3ec;
    margin-top: 2rem;
    padding-top: 1rem;
  }

  .contact-form-section__note span {
    color: #8792a2;
    font-size: 0.62rem;
  }

  .contact-form-section__note strong {
    color: #273951;
    font-size: 0.76rem;
  }

  .contact-form {
    border: 1px solid #dde3ec;
    border-radius: 0.9rem;
    background: #ffffff;
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow:
      0 22px 50px rgba(10, 31, 63, 0.055);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 1rem 1.15rem;
  }

  .contact-field {
    display: grid;
    gap: 0.4rem;
  }

  .contact-field--full {
    grid-column: 1 / -1;
  }

  .contact-field label {
    color: #293950;
    font-size: 0.71rem;
    font-weight: 750;
  }

  .contact-field label span {
    color: #0b2f8f;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    border: 1px solid #ccd6e2;
    border-radius: 0.52rem;
    outline: none;
    background: #ffffff;
    color: #17283f;
    font: inherit;
    font-size: 0.82rem;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .contact-field input {
    min-height: 3rem;
    padding-inline: 0.8rem;
  }

  .contact-field textarea {
    min-height: 9rem;
    resize: vertical;
    padding: 0.8rem;
    line-height: 1.6;
  }

  .contact-field input:focus,
  .contact-field textarea:focus {
    border-color: #1746c7;
    box-shadow:
      0 0 0 3px rgba(23, 70, 199, 0.09);
  }

  .contact-field > p {
    min-height: 0.8rem;
    margin: 0;
    color: #0b2f8f;
    font-size: 0.62rem;
  }

  .contact-field--invalid input,
  .contact-field--invalid textarea {
    border-color: #1746c7;
  }

  .contact-form__status {
    margin-top: 0.6rem;
    font-size: 0.72rem;
  }

  .contact-form__status--success,
  .contact-form__status--error {
    border-radius: 0.45rem;
    padding: 0.7rem 0.8rem;
  }

  .contact-form__status--success {
    background: #ecfdf3;
    color: #067647;
  }

  .contact-form__status--error {
    background: #eef3ff;
    color: #0b2f8f;
  }

  .contact-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid #e1e6ed;
    margin-top: 1rem;
    padding-top: 1rem;
  }

  .contact-form__footer p {
    max-width: 26rem;
    margin: 0;
    color: #8490a1;
    font-size: 0.64rem;
    line-height: 1.5;
  }

  .contact-form__footer button {
    display: inline-flex;
    min-height: 3rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 0;
    border-radius: 0.5rem;
    background: #0b2f8f;
    color: #ffffff;
    cursor: pointer;
    padding-inline: 1.15rem;
    font: inherit;
    font-size: 0.74rem;
    font-weight: 750;
  }

  @media (max-width: 56rem) {
    .contact-form-section__layout {
      grid-template-columns: 1fr;
    }

    .contact-form-section__intro {
      position: static;
    }
  }

  @media (max-width: 38rem) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-field--full {
      grid-column: auto;
    }

    .contact-form__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .contact-form__footer button {
      width: 100%;
    }
  }
</style>
