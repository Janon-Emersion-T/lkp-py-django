---
import {
  getPublicTeams,
} from "../../lib/team/api";

import type {
  PublicTeamMember,
} from "../../lib/team/types";

const teams =
  (await getPublicTeams())
    .filter(
      (team) =>
        Array.isArray(team.members)
        && team.members.length > 0,
    );

const leadershipMap =
  new Map<string, PublicTeamMember>();

for (const team of teams) {
  for (const member of team.members) {
    if (member.is_leadership) {
      leadershipMap.set(
        member.id,
        member,
      );
    }
  }
}

const leadership =
  Array.from(
    leadershipMap.values(),
  );

const initials = (
  name: string,
) =>
  name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map(
      (part) =>
        part.charAt(0).toUpperCase(),
    )
    .join("");

const visibleServices = (
  member: PublicTeamMember,
) =>
  Array.isArray(member.services)
    ? member.services.filter(
        (service) =>
          service.is_public
          && service.service_title,
      )
    : [];

const socialLinks = (
  member: PublicTeamMember,
) => [
  [
    "LinkedIn",
    member.linkedin_url,
  ],
  [
    "GitHub",
    member.github_url,
  ],
  [
    "Portfolio",
    member.portfolio_url,
  ],
  [
    "Website",
    member.website_url,
  ],
].filter(
  (
    item,
  ): item is [string, string] =>
    Boolean(item[1]),
);
---

<section
  class="team-directory"
  aria-labelledby="team-directory-title"
>
  <div class="site-container">
    <header class="team-directory__heading">
      <div>
        <p class="team-directory__eyebrow">
          Meet LKP
        </p>

        <h2 id="team-directory-title">
          Expertise across disciplines.
        </h2>
      </div>

      <p>
        The people behind LKProfessionals,
        organised around the work they lead
        and deliver.
      </p>
    </header>

    {
      teams.length === 0 ? (
        <div class="team-directory__empty">
          <span>Our team</span>

          <h3>
            Team profiles are being prepared.
          </h3>

          <p>
            Published profiles will appear here
            when they are released through the
            LKProfessionals team workspace.
          </p>
        </div>
      ) : (
        <>
          {
            leadership.length > 0 && (
              <section class="team-directory__section">
                <header class="team-directory__section-heading">
                  <span>
                    Leadership
                  </span>
                </header>

                <div
                  class="
                    team-directory__people
                    team-directory__people--leadership
                  "
                >
                  {
                    leadership.map(
                      (member) => (
                        <article class="team-member">
                          <div class="team-member__portrait">
                            {
                              member.profile_image_url ? (
                                <img
                                  src={
                                    member
                                      .profile_image_url
                                  }
                                  alt={member.display_name}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : (
                                <div
                                  class="team-member__placeholder"
                                  aria-hidden="true"
                                >
                                  <span>
                                    {
                                      initials(
                                        member
                                          .display_name,
                                      )
                                    }
                                  </span>
                                </div>
                              )
                            }

                            {
                              member.is_featured && (
                                <span class="team-member__featured">
                                  Featured
                                </span>
                              )
                            }
                          </div>

                          <div class="team-member__body">
                            <div>
                              <h3>
                                {member.display_name}
                              </h3>

                              <p class="team-member__title">
                                {
                                  member
                                    .professional_title
                                  || member.job_title
                                }
                              </p>
                            </div>

                            {
                              member.short_bio && (
                                <p class="team-member__bio">
                                  {member.short_bio}
                                </p>
                              )
                            }

                            {
                              visibleServices(
                                member,
                              ).length > 0 && (
                                <div class="team-member__services">
                                  {
                                    visibleServices(
                                      member,
                                    ).map(
                                      (service) => (
                                        <span>
                                          {
                                            service
                                              .service_title
                                          }
                                        </span>
                                      ),
                                    )
                                  }
                                </div>
                              )
                            }

                            {
                              socialLinks(member)
                                .length > 0 && (
                                <div class="team-member__links">
                                  {
                                    socialLinks(
                                      member,
                                    ).map(
                                      ([
                                        label,
                                        href,
                                      ]) => (
                                        <a
                                          href={href}
                                          target="_blank"
                                          rel="noopener noreferrer"
                                        >
                                          {label}
                                        </a>
                                      ),
                                    )
                                  }
                                </div>
                              )
                            }
                          </div>
                        </article>
                      ),
                    )
                  }
                </div>
              </section>
            )
          }

          {
            teams.map((team) => {
              const members =
                team.members.filter(
                  (member) =>
                    !member.is_leadership,
                );

              if (members.length === 0) {
                return null;
              }

              return (
                <section class="team-directory__section">
                  <header class="team-directory__section-heading">
                    <div>
                      <span>
                        {team.name}
                      </span>

                      {
                        team.description && (
                          <p>
                            {team.description}
                          </p>
                        )
                      }
                    </div>
                  </header>

                  <div class="team-directory__people">
                    {
                      members.map(
                        (member) => (
                          <article class="team-member">
                            <div class="team-member__portrait">
                              {
                                member.profile_image_url ? (
                                  <img
                                    src={
                                      member
                                        .profile_image_url
                                    }
                                    alt={member.display_name}
                                    loading="lazy"
                                    decoding="async"
                                  />
                                ) : (
                                  <div
                                    class="team-member__placeholder"
                                    aria-hidden="true"
                                  >
                                    <span>
                                      {
                                        initials(
                                          member
                                            .display_name,
                                        )
                                      }
                                    </span>
                                  </div>
                                )
                              }

                              {
                                member.is_featured && (
                                  <span class="team-member__featured">
                                    Featured
                                  </span>
                                )
                              }
                            </div>

                            <div class="team-member__body">
                              <div>
                                <h3>
                                  {member.display_name}
                                </h3>

                                <p class="team-member__title">
                                  {
                                    member
                                      .professional_title
                                    || member.job_title
                                  }
                                </p>
                              </div>

                              {
                                member.short_bio && (
                                  <p class="team-member__bio">
                                    {member.short_bio}
                                  </p>
                                )
                              }

                              {
                                visibleServices(
                                  member,
                                ).length > 0 && (
                                  <div class="team-member__services">
                                    {
                                      visibleServices(
                                        member,
                                      ).map(
                                        (service) => (
                                          <span>
                                            {
                                              service
                                                .service_title
                                            }
                                          </span>
                                        ),
                                      )
                                    }
                                  </div>
                                )
                              }

                              {
                                socialLinks(
                                  member,
                                ).length > 0 && (
                                  <div class="team-member__links">
                                    {
                                      socialLinks(
                                        member,
                                      ).map(
                                        ([
                                          label,
                                          href,
                                        ]) => (
                                          <a
                                            href={href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                          >
                                            {label}
                                          </a>
                                        ),
                                      )
                                    }
                                  </div>
                                )
                              }
                            </div>
                          </article>
                        ),
                      )
                    }
                  </div>
                </section>
              );
            })
          }
        </>
      )
    }
  </div>
</section>

<style>
  .team-directory {
    background: #f7f9fc;

    padding-block:
      clamp(5rem, 10vw, 9rem);
  }

  .team-directory__heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(15rem, 0.38fr);

    gap: clamp(2rem, 7vw, 6rem);

    align-items: end;

    margin-bottom:
      clamp(4rem, 8vw, 7rem);
  }

  .team-directory__eyebrow {
    margin: 0 0 1rem;

    color: #0b2f8f;

    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .team-directory__heading h2 {
    max-width: 11ch;

    margin: 0;

    color: #0b1e3a;

    font-family: var(--font-serif);

    font-size:
      clamp(3rem, 6vw, 5.5rem);

    font-weight: 400;

    letter-spacing: -0.055em;

    line-height: 0.95;
  }

  .team-directory__heading
    > p {
    margin: 0;

    color: #69768a;

    font-size: 0.78rem;

    line-height: 1.8;
  }

  .team-directory__section {
    margin-top:
      clamp(4rem, 8vw, 7rem);
  }

  .team-directory__section-heading {
    border-top:
      1px solid #ccd6e2;

    padding-top: 1rem;

    margin-bottom: 2rem;
  }

  .team-directory__section-heading span {
    color: #0b2f8f;

    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .team-directory__section-heading p {
    max-width: 40rem;

    margin: 0.7rem 0 0;

    color: #778497;

    font-size: 0.7rem;

    line-height: 1.7;
  }

  .team-directory__people {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 1px;

    background: #d8e0e9;

    border: 1px solid #d8e0e9;
  }

  .team-directory__people--leadership {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .team-member {
    background: #fff;
  }

  .team-member__portrait {
    position: relative;

    aspect-ratio: 4 / 3;

    overflow: hidden;

    background: #e8edf3;
  }

  .team-member__portrait img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .team-member__placeholder {
    display: grid;

    width: 100%;
    height: 100%;

    place-items: center;

    background:
      linear-gradient(
        135deg,
        #e9eef4,
        #dce5ee
      );

    color: #0b2f8f;

    font-family:
      var(--font-serif);

    font-size:
      clamp(2.5rem, 6vw, 5rem);
  }

  .team-member__featured {
    position: absolute;

    right: 1rem;
    bottom: 1rem;

    background: #0b2f8f;

    padding:
      0.4rem 0.6rem;

    color: #fff;

    font-size: 0.55rem;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .team-member__body {
    padding:
      clamp(1.4rem, 3vw, 2rem);
  }

  .team-member h3 {
    margin: 0;

    color: #0b1e3a;

    font-family:
      var(--font-serif);

    font-size:
      clamp(1.6rem, 3vw, 2.35rem);

    font-weight: 400;

    letter-spacing: -0.035em;
  }

  .team-member__title {
    margin: 0.45rem 0 0;

    color: #0b2f8f;

    font-size: 0.66rem;

    font-weight: 700;

    letter-spacing: 0.04em;
  }

  .team-member__bio {
    margin: 1.2rem 0 0;

    color: #657286;

    font-size: 0.72rem;

    line-height: 1.75;
  }

  .team-member__services {
    display: flex;
    flex-wrap: wrap;

    gap: 0.4rem;

    margin-top: 1.4rem;
  }

  .team-member__services span {
    border:
      1px solid #d8e0e9;

    padding:
      0.35rem 0.5rem;

    color: #667488;

    font-size: 0.55rem;
  }

  .team-member__links {
    display: flex;
    flex-wrap: wrap;

    gap: 1rem;

    border-top:
      1px solid #e0e6ed;

    margin-top: 1.5rem;

    padding-top: 1rem;
  }

  .team-member__links a {
    color: #0b2f8f;

    font-size: 0.6rem;

    font-weight: 700;
  }

  .team-directory__empty {
    border-top:
      1px solid #ccd6e2;

    border-bottom:
      1px solid #ccd6e2;

    padding-block:
      clamp(3rem, 6vw, 5rem);
  }

  .team-directory__empty > span {
    color: #0b2f8f;

    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .team-directory__empty h3 {
    margin: 1rem 0 0;

    color: #0b1e3a;

    font-family:
      var(--font-serif);

    font-size:
      clamp(2rem, 4vw, 3.5rem);

    font-weight: 400;

    letter-spacing: -0.04em;
  }

  .team-directory__empty p {
    max-width: 40rem;

    margin: 1rem 0 0;

    color: #69768a;

    font-size: 0.75rem;

    line-height: 1.8;
  }

  @media (max-width: 58rem) {
    .team-directory__heading {
      grid-template-columns: 1fr;
    }

    .team-directory__people,
    .team-directory__people--leadership {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }
  }

  @media (max-width: 38rem) {
    .team-directory__people,
    .team-directory__people--leadership {
      grid-template-columns: 1fr;
    }
  }
</style>
