---
import { site } from "../../config/site";
import DesktopNavigation from "./header/DesktopNavigation.astro";
import MobileNavigation from "./header/MobileNavigation.astro";

const pathname = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="site-container site-header__inner">
    <a
      href="/"
      class="site-brand"
      aria-label={`${site.name} home`}
    >
      <span class="site-brand__logos">
        <img
          src="/brand/logo.png"
          alt={site.name}
          width="188"
          height="65"
          class="site-brand__image site-brand__image--default"
        />

        <img
          src="/brand/logo-white.png"
          alt=""
          width="188"
          height="65"
          class="site-brand__image site-brand__image--scrolled"
          aria-hidden="true"
        />
      </span>
    </a>

    <DesktopNavigation pathname={pathname} />

    <div class="site-header__actions">
      <a
        href="/get-a-quote/"
        class="site-header__quote"
        data-open-quote-modal
      >
        Get a Quote

        <svg
          aria-hidden="true"
          width="15"
          height="15"
          viewBox="0 0 15 15"
        >
          <path
            d="M2.5 7.5h10M8.5 3.5l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.4"
          />
        </svg>
      </a>

      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Open navigation menu"
        data-menu-button
      >
        <span class="menu-button__label">Menu</span>

        <span class="menu-button__lines" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

</header>

<MobileNavigation pathname={pathname} />

<script>
  const initialiseSiteHeader = () => {
    const header =
      document.querySelector<HTMLElement>(
        "[data-site-header]",
      );

    const menuButton =
      document.querySelector<HTMLButtonElement>(
        "[data-menu-button]",
      );

    const mobileNavigation =
      document.querySelector<HTMLElement>(
        "[data-mobile-navigation]",
      );

    const backdrop =
      document.querySelector<HTMLElement>(
        "[data-mobile-navigation-backdrop]",
      );

    if (
      !header
      || !menuButton
      || !mobileNavigation
    ) {
      return;
    }

    if (
      header.dataset.controllerReady
      === "true"
    ) {
      return;
    }

    header.dataset.controllerReady = "true";

    const setMenuState = (
      open: boolean,
    ) => {
      menuButton.setAttribute(
        "aria-expanded",
        String(open),
      );

      menuButton.setAttribute(
        "aria-label",
        open
          ? "Close navigation menu"
          : "Open navigation menu",
      );

      mobileNavigation.dataset.open =
        String(open);

      mobileNavigation.setAttribute(
        "aria-hidden",
        String(!open),
      );

      if (open) {
        mobileNavigation.removeAttribute(
          "inert",
        );
      } else {
        mobileNavigation.setAttribute(
          "inert",
          "",
        );
      }

      document.documentElement
        .classList
        .toggle(
          "navigation-open",
          open,
        );
    };

    const closeMenu = () => {
      setMenuState(false);
    };

    menuButton.addEventListener(
      "click",
      () => {
        const currentlyOpen =
          menuButton.getAttribute(
            "aria-expanded",
          ) === "true";

        setMenuState(!currentlyOpen);
      },
    );

    backdrop?.addEventListener(
      "click",
      closeMenu,
    );

    mobileNavigation
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener(
          "click",
          closeMenu,
        );
      });

    window.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      },
    );

    const desktopBreakpoint =
      window.matchMedia(
        "(min-width: 68.001rem)",
      );

    desktopBreakpoint.addEventListener(
      "change",
      (event) => {
        if (event.matches) {
          closeMenu();
        }
      },
    );

    const updateHeader = () => {
      header.toggleAttribute(
        "data-scrolled",
        window.scrollY > 12,
      );
    };

    window.addEventListener(
      "scroll",
      updateHeader,
      {
        passive: true,
      },
    );

    setMenuState(false);
    updateHeader();
  };

  if (
    document.readyState === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseSiteHeader,
      {
        once: true,
      },
    );
  } else {
    initialiseSiteHeader();
  }

  document.addEventListener(
    "astro:page-load",
    initialiseSiteHeader,
  );
</script>

<style is:global>
  :root {
    --header-height: 4.75rem;
  }

  html.navigation-open {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    --header-foreground: #26354a;
    --header-muted: #314056;
    --header-background: rgba(255, 255, 255, 0.96);

    position: sticky;
    top: 0;
    z-index: 100;

    width: 100%;
    margin-inline: auto;

    border-radius: 0;
    border-bottom: 1px solid rgba(14, 35, 67, 0.1);
    background: var(--header-background);
    color: var(--header-foreground);
    backdrop-filter: blur(12px);

    transition:
      background-color 220ms ease,
      color 220ms ease,
      width 220ms ease,
      top 220ms ease,
      border-radius 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .site-header[data-scrolled] {
    top: 0.65rem;

    width: calc(100% - 1.3rem);
    max-width: 94rem;

    border-radius: 1rem;

    overflow: visible;
    --header-foreground: #f4f1e8;
    --header-muted: rgba(244, 241, 232, 0.84);
    --header-background: #0b2f8f;

    border-bottom-color: rgba(255, 255, 255, 0.16);

    box-shadow:
      0 10px 30px rgba(7, 31, 101, 0.2),
      0 2px 8px rgba(7, 31, 101, 0.1);
  }

  .site-header__inner {
    display: grid;
    border-radius: inherit;
    min-height: var(--header-height);
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .site-brand {
    display: inline-flex;
    width: 10.8rem;
    align-items: center;
  }

  .site-brand__logos {
    position: relative;
    display: inline-flex;
    width: 100%;
    align-items: center;
  }

  .site-brand__image {
    width: auto;
    max-width: 100%;
    max-height: 3.15rem;
    object-fit: contain;
    object-position: left center;

    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .site-brand__image--scrolled {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    visibility: hidden;
  }

  .site-header[data-scrolled]
    .site-brand__image--default {
    opacity: 0;
    visibility: hidden;
  }

  .site-header[data-scrolled]
    .site-brand__image--scrolled {
    opacity: 1;
    visibility: visible;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.95rem;
  }

  .site-header__contact {
    color: var(--header-muted);
    font-size: 0.78rem;
    font-weight: 700;
    transition: color 150ms ease;
  }

  .site-header__contact:hover {
    color: #0b2f8f;
  }

  .site-header[data-scrolled]
    .site-header__contact:hover {
    color: #ffffff;
  }

  .site-header__quote {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    background: #0b2f8f;
    color: #ffffff;
    padding-inline: 1rem;
    font-size: 0.77rem;
    font-weight: 750;
    transition:
      background-color 170ms ease,
      border-color 170ms ease,
      color 170ms ease,
      transform 170ms ease;
  }

  .site-header__quote:hover {
    transform: translateY(-1px);
    background: #1746c7;
  }

  .site-header[data-scrolled]
    .site-header__quote {
    border-color: rgba(255, 255, 255, 0.9);
    background: #f4f1e8;
    color: #0b2f8f;
  }

  .site-header[data-scrolled]
    .site-header__quote:hover {
    background: #ffffff;
    color: #071f65;
  }

  .site-header__quote svg {
    transition: transform 170ms ease;
  }

  .site-header__quote:hover svg {
    transform: translateX(0.18rem);
  }

  .menu-button {
    display: none;
    min-width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid #d6dde8;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #17273e;
    cursor: pointer;
    padding-inline: 0.8rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 750;

    transition:
      background-color 170ms ease,
      border-color 170ms ease,
      color 170ms ease;
  }

  .site-header[data-scrolled]
    .menu-button {
    border-color: rgba(244, 241, 232, 0.42);
    background: rgba(255, 255, 255, 0.08);
    color: #f4f1e8;
  }

  .site-header[data-scrolled]
    .menu-button:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.14);
  }

  .menu-button__lines {
    display: grid;
    width: 1.05rem;
    gap: 0.27rem;
  }

  .menu-button__lines span {
    display: block;
    height: 1px;
    background: currentColor;
    transition:
      transform 170ms ease,
      opacity 170ms ease;
  }

  .menu-button[aria-expanded="true"]
    .menu-button__lines span:first-child {
    transform: translateY(0.14rem) rotate(45deg);
  }

  .menu-button[aria-expanded="true"]
    .menu-button__lines span:last-child {
    transform: translateY(-0.14rem) rotate(-45deg);
  }

  @media (max-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .site-header__quote {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }

  @media (max-width: 34rem) {
    .site-header[data-scrolled] {
      top: 0.45rem;
      width: calc(100% - 0.8rem);
      border-radius: 0.8rem;
    }

    .site-brand {
      width: 9.5rem;
    }

    .menu-button__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .menu-button {
      width: 2.85rem;
      min-width: 2.85rem;
      height: 2.85rem;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__quote,
    .site-header__quote svg,
    .menu-button__lines span {
      transition: none;
    }
  }
</style>
