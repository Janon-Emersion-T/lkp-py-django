---
import { site } from "../../config/site";
import DesktopNavigation from "./header/DesktopNavigation.astro";
import MobileNavigation from "./header/MobileNavigation.astro";

const pathname = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="site-container site-header__inner">
    <a
      href="/"
      class="site-brand"
      aria-label={`${site.name} home`}
    >
      <img
        src="/brand/logo.png"
        alt={site.name}
        width="188"
        height="65"
        class="site-brand__image"
      />
    </a>

    <DesktopNavigation pathname={pathname} />

    <div class="site-header__actions">
      <a href="/get-a-quote/" class="site-header__quote">
        Get a Quote

        <svg
          aria-hidden="true"
          width="15"
          height="15"
          viewBox="0 0 15 15"
        >
          <path
            d="M2.5 7.5h10M8.5 3.5l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.4"
          />
        </svg>
      </a>

      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Open navigation menu"
        data-menu-button
      >
        <span class="menu-button__label">Menu</span>

        <span class="menu-button__lines" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <MobileNavigation pathname={pathname} />
</header>

<script>
  const header = document.querySelector<HTMLElement>(
    "[data-site-header]",
  );

  const menuButton = document.querySelector<HTMLButtonElement>(
    "[data-menu-button]",
  );

  const mobileNavigation = document.querySelector<HTMLElement>(
    "[data-mobile-navigation]",
  );

  const closeMenu = () => {
    if (!menuButton || !mobileNavigation) {
      return;
    }

    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Open navigation menu");

    mobileNavigation.hidden = true;

    document.documentElement.classList.remove("navigation-open");
  };

  const openMenu = () => {
    if (!menuButton || !mobileNavigation) {
      return;
    }

    menuButton.setAttribute("aria-expanded", "true");
    menuButton.setAttribute("aria-label", "Close navigation menu");

    mobileNavigation.hidden = false;

    document.documentElement.classList.add("navigation-open");
  };

  menuButton?.addEventListener("click", () => {
    const isOpen =
      menuButton.getAttribute("aria-expanded") === "true";

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileNavigation
    ?.querySelectorAll("a")
    .forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  const updateHeader = () => {
    header?.toggleAttribute(
      "data-scrolled",
      window.scrollY > 12,
    );
  };

  window.addEventListener(
    "scroll",
    updateHeader,
    { passive: true },
  );

  updateHeader();
</script>

<style is:global>
  :root {
    --header-height: 4.75rem;
  }

  html.navigation-open {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(14, 35, 67, 0.1);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    transition:
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .site-header[data-scrolled] {
    border-bottom-color: rgba(14, 35, 67, 0.14);
    box-shadow: 0 8px 26px rgba(13, 32, 63, 0.055);
  }

  .site-header__inner {
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .site-brand {
    display: inline-flex;
    width: 10.8rem;
    align-items: center;
  }

  .site-brand__image {
    width: auto;
    max-width: 100%;
    max-height: 3.15rem;
    object-fit: contain;
    object-position: left center;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.95rem;
  }

  .site-header__contact {
    color: #314056;
    font-size: 0.78rem;
    font-weight: 700;
    transition: color 150ms ease;
  }

  .site-header__contact:hover {
    color: #0b2f8f;
  }

  .site-header__quote {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 0.5rem;
    background: #0b2f8f;
    color: #ffffff;
    padding-inline: 1rem;
    font-size: 0.77rem;
    font-weight: 750;
    transition:
      background-color 170ms ease,
      transform 170ms ease;
  }

  .site-header__quote:hover {
    transform: translateY(-1px);
    background: #1746c7;
  }

  .site-header__quote svg {
    transition: transform 170ms ease;
  }

  .site-header__quote:hover svg {
    transform: translateX(0.18rem);
  }

  .menu-button {
    display: none;
    min-width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid #d6dde8;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #17273e;
    cursor: pointer;
    padding-inline: 0.8rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 750;
  }

  .menu-button__lines {
    display: grid;
    width: 1.05rem;
    gap: 0.27rem;
  }

  .menu-button__lines span {
    display: block;
    height: 1px;
    background: currentColor;
    transition:
      transform 170ms ease,
      opacity 170ms ease;
  }

  .menu-button[aria-expanded="true"]
    .menu-button__lines span:first-child {
    transform: translateY(0.14rem) rotate(45deg);
  }

  .menu-button[aria-expanded="true"]
    .menu-button__lines span:last-child {
    transform: translateY(-0.14rem) rotate(-45deg);
  }

  @media (max-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .site-header__quote {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }

  @media (max-width: 34rem) {
    .site-brand {
      width: 9.5rem;
    }

    .menu-button__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .menu-button {
      width: 2.85rem;
      min-width: 2.85rem;
      height: 2.85rem;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__quote,
    .site-header__quote svg,
    .menu-button__lines span {
      transition: none;
    }
  }
</style>
