---
import type { FooterLink } from "../../../config/footer";

interface Props {
  title: string;
  links: FooterLink[];
  columns?: 1 | 2;
}

const {
  title,
  links,
  columns = 1,
} = Astro.props;
---

<nav
  class:list={[
    "footer-navigation",
    columns === 2 && "footer-navigation--two-columns",
  ]}
  aria-label={`${title} links`}
>
  <h2>{title}</h2>

  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>
            <span>{link.label}</span>

            <svg
              aria-hidden="true"
              width="13"
              height="13"
              viewBox="0 0 13 13"
            >
              <path
                d="M2 6.5h8.5M7 3l3.5 3.5L7 10"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.3"
              />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .footer-navigation {
    min-width: 0;
  }

  .footer-navigation h2 {
    margin: 0 0 1.5rem;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.69rem;
    font-weight: 760;
    letter-spacing: 0.17em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .footer-navigation ul {
    display: grid;
    gap: 0.72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-navigation--two-columns ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
  }

  .footer-navigation a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.84rem;
    line-height: 1.45;
    transition:
      color 170ms ease,
      transform 170ms ease;
  }

  .footer-navigation a svg {
    flex: 0 0 auto;
    transform: translateX(-0.25rem);
    opacity: 0;
    transition:
      opacity 170ms ease,
      transform 170ms ease;
  }

  .footer-navigation a:hover {
    transform: translateX(0.18rem);
    color: #ffffff;
  }

  .footer-navigation a:hover svg {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 40rem) {
    .footer-navigation--two-columns ul {
      grid-template-columns: 1fr;
    }
  }
</style>
