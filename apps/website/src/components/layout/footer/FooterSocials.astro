---
import {
  footerSocialLinks,
  type SocialLink,
} from "../../../config/footer";

function iconPath(platform: SocialLink["platform"]) {
  const paths: Record<SocialLink["platform"], string> = {
    linkedin:
      "M6.5 8.4V18M6.5 5.4v.1M11 18v-5.3c0-2.7 4.5-2.9 4.5 0V18M3 21h18V3H3v18Z",
    facebook:
      "M14 8h3V4.5c-.6-.1-1.8-.2-3-.2-3 0-5 1.8-5 5.1V12H6v4h3v5h4v-5h3.2l.8-4H13V9.8c0-1.2.3-1.8 1-1.8Z",
    instagram:
      "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm4 4.5A4.5 4.5 0 1 0 12 16.5 4.5 4.5 0 0 0 12 7.5Zm5.3-.8h.1",
    x:
      "M5 4l14 16M19 4 5 20",
    youtube:
      "M21 8.2c-.2-1.5-1-2.3-2.5-2.5C16.7 5.4 14.5 5.3 12 5.3s-4.7.1-6.5.4C4 5.9 3.2 6.7 3 8.2A25 25 0 0 0 2.7 12c0 1.3.1 2.6.3 3.8.2 1.5 1 2.3 2.5 2.5 1.8.3 4 .4 6.5.4s4.7-.1 6.5-.4c1.5-.2 2.3-1 2.5-2.5.2-1.2.3-2.5.3-3.8s-.1-2.6-.3-3.8ZM10 15.5v-7l6 3.5-6 3.5Z",
    tiktok:
      "M14 4v10.2a4.2 4.2 0 1 1-3.5-4.1V14a1.5 1.5 0 1 0 .8 1.3V3h3.3c.5 2 1.8 3.5 4.4 3.8v3.3A8.2 8.2 0 0 1 14 8.5",
  };

  return paths[platform];
}
---

<div class="footer-socials" aria-label="LKProfessionals social media">
  {
    footerSocialLinks.map((social) => (
      <a
        class={`footer-socials__link footer-socials__link--${social.platform}`}
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${social.label} — opens in a new tab`}
        title={social.label}
      >
        <svg
          aria-hidden="true"
          width="19"
          height="19"
          viewBox="0 0 24 24"
        >
          <path
            d={iconPath(social.platform)}
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.65"
          />
        </svg>
      </a>
    ))
  }
</div>

<style>
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .footer-socials__link {
    display: inline-flex;
    width: 2.55rem;
    height: 2.55rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    color: #ffffff;
    box-shadow: 0 8px 18px rgba(5, 20, 57, 0.16);
    transition:
      filter 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .footer-socials__link:hover {
    transform: translateY(-3px);
    filter: brightness(1.08);
    box-shadow: 0 12px 24px rgba(5, 20, 57, 0.25);
  }

  .footer-socials__link--linkedin {
    background: #0a66c2;
  }

  .footer-socials__link--facebook {
    background: #1877f2;
  }

  .footer-socials__link--instagram {
    background:
      radial-gradient(
        circle at 30% 110%,
        #fdf497 0 6%,
        #fd5949 42%,
        #d6249f 64%,
        #285aeb 100%
      );
  }

  .footer-socials__link--x {
    background: #000000;
  }

  .footer-socials__link--youtube {
    background: #ff0000;
  }

  .footer-socials__link--tiktok {
    background: #010101;
    box-shadow:
      -2px 0 0 rgba(37, 244, 238, 0.7),
      2px 0 0 rgba(254, 44, 85, 0.7),
      0 8px 18px rgba(5, 20, 57, 0.16);
  }

  @media (max-width: 36rem) {
    .footer-socials {
      justify-content: center;
    }
  }
</style>
