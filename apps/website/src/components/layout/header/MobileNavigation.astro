---
import { headerNavigation } from "../../../config/navigation";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const routeMatches = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname === href
    || pathname.startsWith(`${href}/`);
};
---

<div
  id="mobile-navigation"
  class="mobile-nav"
  data-mobile-navigation
  data-open="false"
  aria-hidden="true"
  inert
>
  <div
    class="mobile-nav__backdrop"
    data-mobile-navigation-backdrop
    aria-hidden="true"
  ></div>

  <div class="mobile-nav__panel">
    <div class="mobile-nav__inner">
      <nav
        class="mobile-nav__navigation"
        aria-label="Mobile navigation"
      >
        {
          headerNavigation.map((item) => (
            item.children?.length ? (
              <details
                class="mobile-nav__group"
                open={routeMatches(item.href)}
              >
                <summary>
                  <span>{item.label}</span>

                  <svg
                    aria-hidden="true"
                    width="15"
                    height="15"
                    viewBox="0 0 15 15"
                  >
                    <path
                      d="m4 6 3.5 3.5L11 6"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                    />
                  </svg>
                </summary>

                <div class="mobile-nav__children">
                  <a
                    class:list={[
                      "mobile-nav__overview",
                      routeMatches(item.href)
                        && "mobile-nav__child--active",
                    ]}
                    href={item.href}
                  >
                    All {item.label}
                  </a>

                  {
                    item.children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          "mobile-nav__child",
                          routeMatches(child.href)
                            && "mobile-nav__child--active",
                        ]}
                      >
                        {child.label}
                      </a>
                    ))
                  }
                </div>
              </details>
            ) : (
              <a
                class:list={[
                  "mobile-nav__direct",
                  routeMatches(item.href)
                    && "mobile-nav__direct--active",
                ]}
                href={item.href}
              >
                {item.label}
              </a>
            )
          ))
        }
      </nav>

      <div class="mobile-nav__actions">
        <a
          href="/contact/"
          class="mobile-nav__contact"
        >
          Contact Us
        </a>

        <a
          href="/get-a-quote/"
          class="mobile-nav__quote"
        >
          Get a Quote

          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 16 16"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 99;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .mobile-nav[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;

    background: rgba(7, 18, 38, 0.3);
    backdrop-filter: blur(3px);

    opacity: 0;

    transition: opacity 180ms ease;
  }

  .mobile-nav[data-open="true"]
    .mobile-nav__backdrop {
    opacity: 1;
  }

  .mobile-nav__panel {
    position: absolute;

    top: calc(
      var(--header-height, 4.75rem)
      + 1.1rem
    );

    right: 0.5rem;
    bottom: 0.5rem;
    left: 0.5rem;

    overflow-y: auto;
    overscroll-behavior: contain;

    border: 1px solid #dce3ed;
    border-radius: 1rem;

    background: #ffffff;

    box-shadow:
      0 24px 60px rgba(7, 25, 57, 0.18),
      0 5px 16px rgba(7, 25, 57, 0.08);

    transform: translateY(-0.65rem);

    transition: transform 190ms ease;
  }

  .mobile-nav[data-open="true"]
    .mobile-nav__panel {
    transform: translateY(0);
  }

  .mobile-nav__inner {
    display: flex;

    width: min(100% - 1.5rem, 46rem);
    min-height: 100%;

    flex-direction: column;
    justify-content: space-between;

    margin-inline: auto;

    padding-block:
      clamp(1rem, 4vw, 1.5rem)
      1.25rem;
  }

  .mobile-nav__navigation {
    border-top: 1px solid #e3e8ef;
  }

  .mobile-nav__direct,
  .mobile-nav__group summary {
    display: flex;

    min-height: 3.75rem;

    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #e3e8ef;

    color: #16263d;

    cursor: pointer;

    font-size: 0.94rem;
    font-weight: 750;

    list-style: none;
  }

  .mobile-nav__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__group summary::marker {
    display: none;
    content: "";
  }

  .mobile-nav__group summary svg {
    transition: transform 170ms ease;
  }

  .mobile-nav__group[open] summary svg {
    transform: rotate(180deg);
  }

  .mobile-nav__direct--active,
  .mobile-nav__group[open] > summary {
    color: #0b2f8f;
  }

  .mobile-nav__children {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 0.25rem;

    border-bottom: 1px solid #e3e8ef;

    background: #f5f7fa;

    padding: 0.65rem;
  }

  .mobile-nav__children a {
    display: flex;
    min-height: 2.65rem;

    align-items: center;

    border-radius: 0.45rem;

    color: #536176;

    padding: 0.65rem 0.75rem;

    font-size: 0.77rem;
    font-weight: 650;

    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .mobile-nav__children a:hover,
  .mobile-nav__child--active {
    background: #ffffff;
    color: #0b2f8f;
  }

  .mobile-nav__overview {
    color: #0b2f8f !important;
    font-weight: 800 !important;
  }

  .mobile-nav__actions {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1.35fr);

    gap: 0.7rem;

    border-top: 1px solid #e3e8ef;

    margin-top: 2rem;

    padding-top: 1.25rem;
  }

  .mobile-nav__contact,
  .mobile-nav__quote {
    display: inline-flex;

    min-height: 3.2rem;

    align-items: center;
    justify-content: center;

    border-radius: 0.55rem;

    font-size: 0.78rem;
    font-weight: 750;
  }

  .mobile-nav__contact {
    border: 1px solid #cbd5e2;

    color: #23334a;
  }

  .mobile-nav__quote {
    gap: 0.55rem;

    background: #0b2f8f;

    color: #ffffff;
  }

  @media (max-width: 34rem) {
    .mobile-nav__panel {
      top: calc(
        var(--header-height, 4.75rem)
        + 0.85rem
      );

      right: 0.35rem;
      bottom: 0.35rem;
      left: 0.35rem;

      border-radius: 0.85rem;
    }

    .mobile-nav__children {
      grid-template-columns: 1fr;
    }

    .mobile-nav__actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav,
    .mobile-nav__backdrop,
    .mobile-nav__panel,
    .mobile-nav__group summary svg {
      transition: none;
    }
  }
</style>
