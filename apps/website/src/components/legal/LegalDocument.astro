---
import Layout from "../../layouts/Layout.astro";
import LegalNav from "./LegalNav.astro";

interface Section {
  title: string;
  paragraphs: string[];
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  updated: string;
  sections: Section[];
}

const {
  title,
  description,
  canonicalPath,
  updated,
  sections,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <LegalNav activePath={canonicalPath.replace(/\/$/, "")} />

  <article class="legal-document">
    <header class="site-container legal-document__header">
      <p class="legal-document__eyebrow">
        Legal
      </p>

      <h1>{title}</h1>

      <p class="legal-document__description">
        {description}
      </p>

      <p class="legal-document__updated">
        Last updated: {updated}
      </p>
    </header>

    <div class="site-container legal-document__body">
      {
        sections.map((section, index) => (
          <section>
            <div class="legal-document__number">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div>
              <h2>{section.title}</h2>

              {
                section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Layout>

<style>
  .legal-document {
    background: #f7f9fc;
  }

  .legal-document__header {
    max-width: 68rem;

    padding-block:
      clamp(5rem, 10vw, 9rem)
      clamp(3rem, 6vw, 5rem);
  }

  .legal-document__eyebrow {
    margin: 0 0 1rem;

    color: #0b2f8f;

    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .legal-document h1 {
    max-width: 11ch;
    margin: 0;

    color: #0b1e3a;

    font-family: var(--font-serif);
    font-size: clamp(3.8rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .legal-document__description {
    max-width: 45rem;

    margin: 1.8rem 0 0;

    color: #657286;

    font-size: 0.9rem;
    line-height: 1.8;
  }

  .legal-document__updated {
    border-top: 1px solid #d5dde7;

    margin: 2rem 0 0;
    padding-top: 1rem;

    color: #8490a0;

    font-size: 0.67rem;
  }

  .legal-document__body {
    max-width: 68rem;
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .legal-document__body section {
    display: grid;

    grid-template-columns:
      3rem
      minmax(0, 44rem);

    gap: clamp(1.5rem, 5vw, 4rem);

    border-top: 1px solid #d8e0e9;

    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .legal-document__number {
    color: #8b97a7;
    font-family: var(--font-serif);
  }

  .legal-document__body h2 {
    margin: 0 0 1.2rem;

    color: #0b1e3a;

    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .legal-document__body p {
    margin: 0 0 1rem;

    color: #53647a;

    font-size: 0.83rem;
    line-height: 1.9;
  }

  @media (max-width: 38rem) {
    .legal-document__body section {
      grid-template-columns: 1fr;
    }

    .legal-document__number {
      display: none;
    }
  }
</style>
