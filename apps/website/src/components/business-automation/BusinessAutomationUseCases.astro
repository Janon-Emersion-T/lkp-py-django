---
const useCases = [
  [
    "Lead handling",
    "Assign leads, trigger follow-ups and create internal actions automatically.",
  ],
  [
    "Approvals",
    "Route requests through the correct decision-makers and record outcomes.",
  ],
  [
    "Employee processes",
    "Coordinate onboarding, requests, documentation and internal notifications.",
  ],
  [
    "Documents",
    "Generate recurring business documents from structured information.",
  ],
  [
    "Notifications",
    "Send messages when defined business events or exceptions occur.",
  ],
  [
    "System hand-offs",
    "Move information between CRM, ERP, finance, communications and other tools.",
  ],
];
---

<section class="automation-usecases">
  <div class="site-container automation-usecases__layout">
    <div>
      <p>Common opportunities</p>

      <h2>
        Look for work that repeats predictably.
      </h2>
    </div>

    <div class="automation-usecases__list">
      {
        useCases.map(([title, description], index) => (
          <article>
            <span>
              {String(index + 1).padStart(2, "0")}
            </span>

            <strong>{title}</strong>

            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .automation-usecases {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .automation-usecases__layout {
    display: grid;
    grid-template-columns:
      minmax(16rem, 0.68fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .automation-usecases__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .automation-usecases h2 {
    max-width: 11ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .automation-usecases__list {
    border-top: 1px solid #dce3ec;
  }

  .automation-usecases article {
    display: grid;
    grid-template-columns:
      3rem
      minmax(8rem, 0.3fr)
      1fr;
    gap: 1rem;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1rem;
  }

  .automation-usecases article > span {
    color: #8792a2;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .automation-usecases article > strong {
    color: #293b53;
    font-size: 0.75rem;
  }

  .automation-usecases article > p {
    margin: 0;
    color: #788497;
    font-size: 0.68rem;
    line-height: 1.6;
  }

  @media (max-width: 52rem) {
    .automation-usecases__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .automation-usecases article {
      grid-template-columns:
        2rem
        1fr;
    }

    .automation-usecases article > p {
      grid-column: 2;
    }
  }
</style>
