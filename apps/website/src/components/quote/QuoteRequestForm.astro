---
import {
  contactTimes,
  preferredContactMethods,
  quoteServices,
} from "../../config/quote";

interface Props {
  surface: "page" | "modal";
}

const { surface } = Astro.props;

const apiBaseUrl =
  import.meta.env.PUBLIC_API_BASE_URL
  ?? "http://127.0.0.1:8082/api/v1";

const formId = `quote-request-${surface}`;
---

<form
  class:list={[
    "quote-form",
    `quote-form--${surface}`,
  ]}
  data-quote-form
  data-surface={surface}
  data-endpoint={`${apiBaseUrl}/enquiries/public/quote`}
  novalidate
>
  <div class="quote-form__grid">
    <div class="quote-field">
      <label for={`${formId}-name`}>
        Full Name
        <span aria-hidden="true">*</span>
      </label>

      <input
        id={`${formId}-name`}
        name="full_name"
        type="text"
        autocomplete="name"
        maxlength="200"
        required
      />

      <p class="quote-field__error" data-error-for="full_name"></p>
    </div>

    <div class="quote-field">
      <label for={`${formId}-company`}>
        Company Name
      </label>

      <input
        id={`${formId}-company`}
        name="company_name"
        type="text"
        autocomplete="organization"
        maxlength="200"
      />

      <p class="quote-field__error" data-error-for="company_name"></p>
    </div>

    <div class="quote-field">
      <label for={`${formId}-service`}>
        Service Required
        <span aria-hidden="true">*</span>
      </label>

      <select
        id={`${formId}-service`}
        name="service_required"
        required
      >
        <option value="">Select a service</option>

        {
          quoteServices.map((service) => (
            <option value={service}>
              {service}
            </option>
          ))
        }
      </select>

      <p class="quote-field__error" data-error-for="service_required"></p>
    </div>

    <div class="quote-field">
      <label for={`${formId}-country`}>
        Country
        <span aria-hidden="true">*</span>
      </label>

      <input
        id={`${formId}-country`}
        name="country"
        type="text"
        autocomplete="country-name"
        maxlength="100"
        required
      />

      <p class="quote-field__error" data-error-for="country"></p>
    </div>

    <div class="quote-field">
      <label for={`${formId}-email`}>
        Email Address
        <span aria-hidden="true">*</span>
      </label>

      <input
        id={`${formId}-email`}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        required
      />

      <p class="quote-field__error" data-error-for="email"></p>
    </div>

    <div class="quote-field">
      <label for={`${formId}-whatsapp`}>
        WhatsApp Number
        <span
          class="quote-field__conditional"
          data-whatsapp-required-label
          hidden
        >
          Required
        </span>
      </label>

      <input
        id={`${formId}-whatsapp`}
        name="whatsapp_number"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        maxlength="50"
        placeholder="+94..."
        data-whatsapp-input
      />

      <p class="quote-field__error" data-error-for="whatsapp_number"></p>
    </div>

    <fieldset class="quote-field quote-field--contact">
      <legend>
        Preferred Contact Method
        <span aria-hidden="true">*</span>
      </legend>

      <div class="quote-options">
        {
          preferredContactMethods.map((method) => (
            <label class="quote-option">
              <input
                type="radio"
                name="preferred_contact_method"
                value={method.value}
                required
                data-contact-method
              />

              <span>{method.label}</span>
            </label>
          ))
        }
      </div>

      <p
        class="quote-field__error"
        data-error-for="preferred_contact_method"
      ></p>
    </fieldset>

    <div class="quote-field">
      <label for={`${formId}-time`}>
        Best Time to Contact
      </label>

      <select
        id={`${formId}-time`}
        name="best_time_to_contact"
      >
        {
          contactTimes.map((time) => (
            <option value={time.value}>
              {time.label}
            </option>
          ))
        }
      </select>

      <p
        class="quote-field__error"
        data-error-for="best_time_to_contact"
      ></p>
    </div>

    <div class="quote-field quote-field--full">
      <label for={`${formId}-description`}>
        Project Description
        <span aria-hidden="true">*</span>
      </label>

      <textarea
        id={`${formId}-description`}
        name="project_description"
        rows="7"
        maxlength="5000"
        required
        placeholder="Tell us about your business, project goals, required features, preferred technologies (if any), and any deadlines."
      ></textarea>

      <div class="quote-field__footer">
        <p
          class="quote-field__error"
          data-error-for="project_description"
        ></p>

        <span data-description-count>
          0 / 5000
        </span>
      </div>
    </div>
  </div>

  <div
    class="quote-form__status"
    data-quote-status
    role="status"
    aria-live="polite"
  ></div>

  <button
    class="quote-form__submit"
    type="submit"
    data-quote-submit
  >
    <span data-submit-label>
      Request Free Quote
    </span>

    <svg
      aria-hidden="true"
      width="17"
      height="17"
      viewBox="0 0 17 17"
    >
      <path
        d="M3 8.5h11M10 4.5l4 4-4 4"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
      />
    </svg>
  </button>

  <p class="quote-form__privacy">
    We respect your privacy. Your information will only be used
    to respond to your enquiry.
  </p>
</form>

<script>
  interface QuotePayload {
    full_name: string;
    company_name: string;
    service_required: string;
    email: string;
    whatsapp_number: string;
    preferred_contact_method: string;
    country: string;
    project_description: string;
    best_time_to_contact: string;
    source_surface: string;
    source_url: string;
  }

  const initialiseQuoteForms = () => {
    document
      .querySelectorAll<HTMLFormElement>(
        "[data-quote-form]",
      )
      .forEach((form) => {
        if (form.dataset.initialised === "true") {
          return;
        }

        form.dataset.initialised = "true";

        const whatsappInput =
          form.querySelector<HTMLInputElement>(
            "[data-whatsapp-input]",
          );

        const whatsappRequiredLabel =
          form.querySelector<HTMLElement>(
            "[data-whatsapp-required-label]",
          );

        const contactMethods =
          form.querySelectorAll<HTMLInputElement>(
            "[data-contact-method]",
          );

        const textarea =
          form.querySelector<HTMLTextAreaElement>(
            'textarea[name="project_description"]',
          );

        const descriptionCount =
          form.querySelector<HTMLElement>(
            "[data-description-count]",
          );

        const status =
          form.querySelector<HTMLElement>(
            "[data-quote-status]",
          );

        const submitButton =
          form.querySelector<HTMLButtonElement>(
            "[data-quote-submit]",
          );

        const submitLabel =
          form.querySelector<HTMLElement>(
            "[data-submit-label]",
          );

        const clearErrors = () => {
          form
            .querySelectorAll<HTMLElement>(
              "[data-error-for]",
            )
            .forEach((element) => {
              element.textContent = "";
            });

          form
            .querySelectorAll<HTMLElement>(
              ".quote-field--invalid",
            )
            .forEach((element) => {
              element.classList.remove(
                "quote-field--invalid",
              );
            });
        };

        const setFieldError = (
          fieldName: string,
          message: string,
        ) => {
          const errorElement =
            form.querySelector<HTMLElement>(
              `[data-error-for="${fieldName}"]`,
            );

          const fieldElement =
            form
              .querySelector<HTMLElement>(
                `[name="${fieldName}"]`,
              )
              ?.closest<HTMLElement>(
                ".quote-field",
              );

          if (errorElement) {
            errorElement.textContent = message;
          }

          fieldElement?.classList.add(
            "quote-field--invalid",
          );
        };

        const selectedContactMethod = () =>
          form.querySelector<HTMLInputElement>(
            'input[name="preferred_contact_method"]:checked',
          )?.value ?? "";

        const updateWhatsappRequirement = () => {
          if (!whatsappInput) {
            return;
          }

          const required =
            selectedContactMethod() === "whatsapp";

          whatsappInput.required = required;

          if (whatsappRequiredLabel) {
            whatsappRequiredLabel.hidden = !required;
          }
        };

        const updateDescriptionCount = () => {
          if (!textarea || !descriptionCount) {
            return;
          }

          descriptionCount.textContent =
            `${textarea.value.length} / 5000`;
        };

        contactMethods.forEach((input) => {
          input.addEventListener(
            "change",
            updateWhatsappRequirement,
          );
        });

        textarea?.addEventListener(
          "input",
          updateDescriptionCount,
        );

        updateWhatsappRequirement();
        updateDescriptionCount();

        form.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            clearErrors();

            if (status) {
              status.textContent = "";
              status.className =
                "quote-form__status";
            }

            const data = new FormData(form);

            const payload: QuotePayload = {
              full_name:
                String(data.get("full_name") ?? "").trim(),

              company_name:
                String(data.get("company_name") ?? "").trim(),

              service_required:
                String(data.get("service_required") ?? "").trim(),

              email:
                String(data.get("email") ?? "").trim(),

              whatsapp_number:
                String(data.get("whatsapp_number") ?? "").trim(),

              preferred_contact_method:
                String(
                  data.get("preferred_contact_method")
                    ?? "",
                ).trim(),

              country:
                String(data.get("country") ?? "").trim(),

              project_description:
                String(
                  data.get("project_description") ?? "",
                ).trim(),

              best_time_to_contact:
                String(
                  data.get("best_time_to_contact") ?? "",
                ).trim(),

              source_surface:
                form.dataset.surface ?? "page",

              source_url:
                window.location.href,
            };

            let firstInvalid:
              | HTMLElement
              | null = null;

            const invalid = (
              field: string,
              message: string,
            ) => {
              setFieldError(field, message);

              if (!firstInvalid) {
                firstInvalid =
                  form.querySelector<HTMLElement>(
                    `[name="${field}"]`,
                  );
              }
            };

            if (!payload.full_name) {
              invalid(
                "full_name",
                "Enter your full name.",
              );
            }

            if (!payload.service_required) {
              invalid(
                "service_required",
                "Select the service you require.",
              );
            }

            const emailInput =
              form.querySelector<HTMLInputElement>(
                'input[name="email"]',
              );

            if (
              !payload.email
              || !emailInput?.checkValidity()
            ) {
              invalid(
                "email",
                "Enter a valid email address.",
              );
            }

            if (!payload.country) {
              invalid(
                "country",
                "Enter your country.",
              );
            }

            if (
              !payload.preferred_contact_method
            ) {
              invalid(
                "preferred_contact_method",
                "Choose how you would prefer us to contact you.",
              );
            }

            if (
              payload.preferred_contact_method
                === "whatsapp"
              && !payload.whatsapp_number
            ) {
              invalid(
                "whatsapp_number",
                "WhatsApp number is required when WhatsApp is your preferred contact method.",
              );
            }

            if (!payload.project_description) {
              invalid(
                "project_description",
                "Tell us a little about your project.",
              );
            }

            if (firstInvalid) {
              firstInvalid.focus();
              return;
            }

            const endpoint =
              form.dataset.endpoint;

            if (!endpoint) {
              if (status) {
                status.textContent =
                  "The quote service is temporarily unavailable.";

                status.classList.add(
                  "quote-form__status--error",
                );
              }

              return;
            }

            if (submitButton) {
              submitButton.disabled = true;
              submitButton.setAttribute(
                "aria-busy",
                "true",
              );
            }

            if (submitLabel) {
              submitLabel.textContent =
                "Sending request…";
            }

            try {
              const response = await fetch(
                endpoint,
                {
                  method: "POST",
                  headers: {
                    "Content-Type":
                      "application/json",
                  },
                  body: JSON.stringify(
                    payload,
                  ),
                },
              );

              const result =
                await response
                  .json()
                  .catch(() => null);

              if (!response.ok) {
                const fieldErrors =
                  result?.details?.errors;

                if (
                  fieldErrors
                  && typeof fieldErrors === "object"
                ) {
                  Object
                    .entries(fieldErrors)
                    .forEach(
                      ([field, messages]) => {
                        setFieldError(
                          field,
                          Array.isArray(messages)
                            ? String(messages[0])
                            : String(messages),
                        );
                      },
                    );
                }

                throw new Error(
                  result?.message
                    ?? "We could not submit your quote request. Please try again.",
                );
              }

              form.reset();

              updateWhatsappRequirement();
              updateDescriptionCount();

              if (status) {
                status.textContent =
                  `Thank you. Your request has been received. Reference: ${result.reference_code}`;

                status.classList.add(
                  "quote-form__status--success",
                );
              }

              document.dispatchEvent(
                new CustomEvent(
                  "lkp:quote-submitted",
                  {
                    detail: result,
                  },
                ),
              );
            } catch (error) {
              if (status) {
                status.textContent =
                  error instanceof Error
                    ? error.message
                    : "We could not submit your quote request. Please try again.";

                status.classList.add(
                  "quote-form__status--error",
                );
              }
            } finally {
              if (submitButton) {
                submitButton.disabled = false;

                submitButton.removeAttribute(
                  "aria-busy",
                );
              }

              if (submitLabel) {
                submitLabel.textContent =
                  "Request Free Quote";
              }
            }
          },
        );
      });
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initialiseQuoteForms,
      {
        once: true,
      },
    );
  } else {
    initialiseQuoteForms();
  }

  document.addEventListener(
    "astro:page-load",
    initialiseQuoteForms,
  );
</script>

<style>
  .quote-form {
    width: 100%;
  }

  .quote-form__grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 1.15rem 1.25rem;
  }

  .quote-field {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
  }

  .quote-field--full {
    grid-column: 1 / -1;
  }

  .quote-field label,
  .quote-field legend {
    color: #24344b;
    font-size: 0.76rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .quote-field label > span,
  .quote-field legend > span {
    color: #b42318;
  }

  .quote-field__conditional {
    display: inline-flex;
    margin-left: 0.4rem;
    border-radius: 999px;
    background: #fef0c7;
    color: #93370d !important;
    padding: 0.15rem 0.45rem;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .quote-field__conditional[hidden] {
    display: none;
  }

  .quote-field input,
  .quote-field select,
  .quote-field textarea {
    width: 100%;
    border: 1px solid #cfd7e3;
    border-radius: 0.55rem;
    outline: 0;
    background: #ffffff;
    color: #15263d;
    font: inherit;
    font-size: 0.86rem;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      background-color 150ms ease;
  }

  .quote-field input,
  .quote-field select {
    min-height: 3.15rem;
    padding-inline: 0.85rem;
  }

  .quote-field textarea {
    min-height: 10rem;
    resize: vertical;
    padding: 0.85rem;
    line-height: 1.65;
  }

  .quote-field input:focus,
  .quote-field select:focus,
  .quote-field textarea:focus {
    border-color: #1746c7;
    box-shadow:
      0 0 0 3px rgba(23, 70, 199, 0.09);
  }

  .quote-field--invalid input,
  .quote-field--invalid select,
  .quote-field--invalid textarea {
    border-color: #d92d20;
    background: #fffafa;
  }

  .quote-field--contact {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .quote-options {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .quote-option {
    display: flex !important;
    min-height: 3.15rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid #cfd7e3;
    border-radius: 0.55rem;
    background: #ffffff;
    cursor: pointer;
    padding-inline: 0.85rem;
  }

  .quote-option:has(input:checked) {
    border-color: #1746c7;
    background: #f3f6ff;
    color: #0b2f8f;
  }

  .quote-option input {
    width: 1rem;
    height: 1rem;
    min-height: auto;
    accent-color: #0b2f8f;
  }

  .quote-field__error {
    min-height: 1rem;
    margin: 0;
    color: #b42318;
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .quote-field__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .quote-field__footer > span {
    flex: 0 0 auto;
    color: #8791a2;
    font-size: 0.65rem;
  }

  .quote-form__status {
    min-height: 1.3rem;
    margin-top: 1rem;
    border-radius: 0.45rem;
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.55;
  }

  .quote-form__status--success {
    background: #ecfdf3;
    color: #067647;
    padding: 0.75rem 0.85rem;
  }

  .quote-form__status--error {
    background: #fef3f2;
    color: #b42318;
    padding: 0.75rem 0.85rem;
  }

  .quote-form__submit {
    display: inline-flex;
    width: 100%;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 0;
    border-radius: 0.55rem;
    background: #0b2f8f;
    color: #ffffff;
    cursor: pointer;
    margin-top: 0.9rem;
    padding-inline: 1.2rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 780;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .quote-form__submit:hover {
    transform: translateY(-1px);
    background: #1746c7;
  }

  .quote-form__submit:disabled {
    cursor: wait;
    opacity: 0.7;
    transform: none;
  }

  .quote-form__privacy {
    margin: 0.75rem 0 0;
    color: #7a8597;
    font-size: 0.68rem;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 42rem) {
    .quote-form__grid {
      grid-template-columns: 1fr;
    }

    .quote-field--full {
      grid-column: auto;
    }
  }

  @media (max-width: 28rem) {
    .quote-options {
      grid-template-columns: 1fr;
    }
  }
</style>
