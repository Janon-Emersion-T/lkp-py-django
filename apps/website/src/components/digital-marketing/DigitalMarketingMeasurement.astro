---
const measurements = [
  [
    "Qualified enquiries",
    "Whether marketing is generating conversations with people who actually fit the business.",
  ],
  [
    "Conversion rate",
    "How effectively visits and campaign interactions become meaningful business actions.",
  ],
  [
    "Acquisition cost",
    "What the business is spending to generate leads or customers through a channel.",
  ],
  [
    "Search visibility",
    "How effectively relevant pages are being discovered for commercially useful searches.",
  ],
  [
    "Lead quality",
    "Whether generated demand matches the services, geography, budget and customer profile the business needs.",
  ],
  [
    "Customer value",
    "The commercial outcome after acquisition, including repeat work and longer-term relationships where measurable.",
  ],
];
---

<section class="marketing-measurement">
  <div class="site-container marketing-measurement__layout">
    <div>
      <p>What deserves attention</p>

      <h2>
        The dashboard should lead back to business reality.
      </h2>
    </div>

    <div class="marketing-measurement__list">
      {
        measurements.map(([title, description], index) => (
          <article>
            <span>
              {String(index + 1).padStart(2, "0")}
            </span>

            <strong>{title}</strong>

            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marketing-measurement {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #f6f8fb;
  }

  .marketing-measurement__layout {
    display: grid;
    grid-template-columns:
      minmax(16rem, 0.68fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  .marketing-measurement__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .marketing-measurement h2 {
    max-width: 12ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .marketing-measurement__list {
    border-top: 1px solid #dce3ec;
  }

  .marketing-measurement article {
    display: grid;
    grid-template-columns:
      3rem
      minmax(9rem, 0.3fr)
      1fr;
    gap: 1rem;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1rem;
  }

  .marketing-measurement article > span {
    color: #8792a2;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .marketing-measurement article > strong {
    color: #293b53;
    font-size: 0.75rem;
  }

  .marketing-measurement article > p {
    margin: 0;
    color: #788497;
    font-size: 0.68rem;
    line-height: 1.6;
  }

  @media (max-width: 52rem) {
    .marketing-measurement__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .marketing-measurement article {
      grid-template-columns:
        2rem
        1fr;
    }

    .marketing-measurement article > p {
      grid-column: 2;
    }
  }
</style>
