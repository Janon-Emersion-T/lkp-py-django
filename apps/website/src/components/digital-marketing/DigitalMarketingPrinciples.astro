---
import {
  marketingPrinciples,
} from "../../config/digital-marketing";
---

<section class="marketing-principles">
  <div class="site-container marketing-principles__layout">
    <div>
      <p>Marketing discipline</p>

      <h2>
        Metrics should explain the business, not decorate a report.
      </h2>
    </div>

    <div class="marketing-principles__list">
      {
        marketingPrinciples.map((principle) => (
          <article>
            <span>{principle.number}</span>

            <div>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marketing-principles {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: #0b2f8f;
    color: #f6f3eb;
  }

  .marketing-principles__layout {
    display: grid;
    grid-template-columns:
      minmax(17rem, 0.72fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .marketing-principles__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: rgba(246, 243, 235, 0.56);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .marketing-principles h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .marketing-principles__list {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .marketing-principles article {
    display: grid;
    grid-template-columns:
      3rem
      1fr;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-block: 1.2rem;
  }

  .marketing-principles article > span {
    color: rgba(246, 243, 235, 0.4);
    font-size: 0.58rem;
    font-weight: 800;
  }

  .marketing-principles h3 {
    margin: 0;
    color: #ffffff;
    font-size: 0.82rem;
  }

  .marketing-principles article p {
    max-width: 42rem;
    margin: 0.45rem 0 0;
    color: rgba(246, 243, 235, 0.65);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  @media (max-width: 52rem) {
    .marketing-principles__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
