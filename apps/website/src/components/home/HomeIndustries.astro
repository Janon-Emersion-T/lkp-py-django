---
import {
  industries,
} from "../../config/industries";

import Container from "../ui/Container.astro";
---

<section class="home-industries">
  <Container>
    <div class="home-industries__top">
      <div>
        <p>Industries</p>

        <h2>
          Context changes
          <em>the right answer.</em>
        </h2>
      </div>

      <div>
        <p>
          Technology for a hotel, school, construction
          company or finance operation cannot be treated
          as the same problem with a different logo.
        </p>

        <a href="/industries/">
          Explore industries ↗
        </a>
      </div>
    </div>

    <div class="home-industries__directory">
      {
        industries.map((industry, index) => (
          <a
            href={industry.href}
            class="home-industry"
          >
            <span class="home-industry__number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3>
              {industry.title}
            </h3>

            <p>
              {industry.areas
                .slice(0, 3)
                .join(" · ")}
            </p>

            <span
              class="home-industry__arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .home-industries {
    background: #fff;

    padding-block:
      clamp(7rem, 13vw, 12rem);
  }

  .home-industries__top {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(17rem, 0.48fr);

    gap: clamp(3rem, 8vw, 8rem);

    align-items: end;

    margin-bottom:
      clamp(5rem, 9vw, 8rem);
  }

  .home-industries__top > div:first-child > p {
    margin: 0 0 1.2rem;

    color: #3459c4;

    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-industries h2 {
    max-width: 11ch;

    margin: 0;

    color: #101c2c;

    font-family: var(--font-serif);

    font-size:
      clamp(3.3rem, 6.8vw, 6.6rem);

    font-weight: 400;

    letter-spacing: -0.064em;

    line-height: 0.91;
  }

  .home-industries h2 em {
    display: block;

    color: #7a8490;

    font-weight: 400;
  }

  .home-industries__top > div:last-child {
    color: #687585;

    font-size: 0.84rem;

    line-height: 1.75;
  }

  .home-industries__top > div:last-child p {
    margin: 0;
  }

  .home-industries__top a {
    display: inline-block;

    margin-top: 1.8rem;

    border-bottom:
      1px solid #101c2c;

    padding-bottom: 0.2rem;

    color: #101c2c;

    font-size: 0.72rem;
    font-weight: 750;
  }

  .home-industries__directory {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    column-gap:
      clamp(3rem, 8vw, 8rem);
  }

  .home-industry {
    position: relative;

    display: grid;

    grid-template-columns:
      2.5rem
      minmax(0, 1fr)
      auto;

    gap: 1rem;

    align-items: baseline;

    border-top:
      1px solid #d5dae0;

    padding-block:
      clamp(1.5rem, 3vw, 2.3rem);
  }

  .home-industry:nth-last-child(-n + 2) {
    border-bottom:
      1px solid #d5dae0;
  }

  .home-industry__number {
    color: #8a95a3;

    font-size: 0.58rem;
  }

  .home-industry h3 {
    margin: 0;

    color: #142235;

    font-family: var(--font-serif);

    font-size:
      clamp(1.7rem, 3vw, 2.7rem);

    font-weight: 400;

    letter-spacing: -0.04em;

    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .home-industry p {
    grid-column: 2;

    margin: 0.5rem 0 0;

    color: #7a8695;

    font-size: 0.65rem;

    line-height: 1.55;
  }

  .home-industry__arrow {
    color: #2e56c2;

    transition:
      transform 180ms ease;
  }

  .home-industry:hover h3 {
    transform: translateX(0.35rem);

    color: #3158c4;
  }

  .home-industry:hover
  .home-industry__arrow {
    transform:
      translate(0.15rem, -0.15rem);
  }

  @media (max-width: 54rem) {
    .home-industries__top {
      grid-template-columns: 1fr;
    }

    .home-industries__directory {
      grid-template-columns: 1fr;
    }

    .home-industry:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .home-industry:last-child {
      border-bottom:
        1px solid #d5dae0;
    }
  }
</style>
