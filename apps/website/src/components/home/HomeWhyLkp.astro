---
import {
  whyChooseReasons,
} from "../../config/why-choose-lkp";

import Container from "../ui/Container.astro";
---

<section class="home-why">
  <Container>
    <div class="home-why__top">
      <p>Why LKProfessionals</p>

      <h2>
        Capability matters.
        <em>Ownership matters more.</em>
      </h2>
    </div>

    <div class="home-why__body">
      <aside>
        <p>
          We prefer long-term technical responsibility
          over short-term delivery theatre.
        </p>

        <a href="/about/why-choose-lkp/">
          Why work with LKP ↗
        </a>
      </aside>

      <div class="home-why__reasons">
        {
          whyChooseReasons.map((reason) => (
            <article>
              <span>
                {reason.number}
              </span>

              <div>
                <h3>
                  {reason.title}
                </h3>

                <p>
                  {reason.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .home-why {
    background: #e9eef8;

    padding-block:
      clamp(7rem, 13vw, 12rem);
  }

  .home-why__top > p {
    margin: 0 0 1.2rem;

    color: #3157c2;

    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-why__top h2 {
    max-width: 12ch;

    margin: 0;

    color: #102039;

    font-family: var(--font-serif);

    font-size:
      clamp(3.4rem, 7vw, 6.8rem);

    font-weight: 400;

    letter-spacing: -0.064em;

    line-height: 0.9;
  }

  .home-why__top em {
    display: block;

    color: #5e6f8c;

    font-weight: 400;
  }

  .home-why__body {
    display: grid;

    grid-template-columns:
      minmax(14rem, 0.36fr)
      minmax(0, 1fr);

    gap: clamp(4rem, 10vw, 10rem);

    margin-top:
      clamp(5rem, 10vw, 9rem);
  }

  .home-why aside {
    position: sticky;

    top: 7rem;

    align-self: start;
  }

  .home-why aside p {
    max-width: 17rem;

    margin: 0;

    color: #5c6b80;

    line-height: 1.7;
  }

  .home-why aside a {
    display: inline-block;

    margin-top: 2rem;

    border-bottom:
      1px solid #102039;

    padding-bottom: 0.2rem;

    color: #102039;

    font-size: 0.7rem;
    font-weight: 750;
  }

  .home-why__reasons {
    border-top:
      1px solid #c2cbda;
  }

  .home-why__reasons article {
    display: grid;

    grid-template-columns:
      3rem
      minmax(0, 1fr);

    gap: 1rem;

    border-bottom:
      1px solid #c2cbda;

    padding-block:
      clamp(2rem, 4vw, 3rem);
  }

  .home-why__reasons article > span {
    color: #3157c2;

    font-size: 0.6rem;
    font-weight: 800;
  }

  .home-why__reasons h3 {
    margin: 0;

    color: #102039;

    font-family: var(--font-serif);

    font-size:
      clamp(1.8rem, 3.5vw, 3rem);

    font-weight: 400;

    letter-spacing: -0.045em;
  }

  .home-why__reasons p {
    max-width: 40rem;

    margin: 0.8rem 0 0;

    color: #66758a;

    font-size: 0.8rem;

    line-height: 1.7;
  }

  @media (max-width: 52rem) {
    .home-why__body {
      grid-template-columns: 1fr;
    }

    .home-why aside {
      position: static;
    }
  }
</style>
