---
import type {
  PublicTestimonial,
} from "../../lib/testimonials/types";

import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextLink from "../ui/TextLink.astro";

interface Props {
  testimonials: PublicTestimonial[];
}

const {
  testimonials,
} = Astro.props;
---

{
  testimonials.length > 0 && (
    <section class="home-testimonials section-space">
      <Container>
        <SectionHeading
          eyebrow="Client perspective"
          title="What matters after delivery."
          description="Published feedback from clients who have worked with LKProfessionals."
          align="split"
        />

        <div class="home-testimonials__grid">
          {
            testimonials.map((testimonial) => (
              <article>
                <blockquote>
                  “{
                    testimonial.short_content
                    || testimonial.content
                  }”
                </blockquote>

                <footer>
                  <strong>
                    {testimonial.author_name}
                  </strong>

                  {
                    (
                      testimonial.author_position
                      || testimonial.company_name
                    ) && (
                      <span>
                        {
                          [
                            testimonial.author_position,
                            testimonial.company_name,
                          ]
                            .filter(Boolean)
                            .join(" · ")
                        }
                      </span>
                    )
                  }
                </footer>
              </article>
            ))
          }
        </div>

        <div class="home-testimonials__footer">
          <TextLink
            href="/testimonials/"
            label="Read client testimonials"
          />
        </div>
      </Container>
    </section>
  )
}

<style>
  .home-testimonials {
    background: var(--colour-soft-blue);
  }

  .home-testimonials__grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--colour-line);
    border-left: 1px solid var(--colour-line);
  }

  .home-testimonials article {
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--colour-line);
    border-bottom: 1px solid var(--colour-line);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: rgba(255, 255, 255, 0.4);
  }

  .home-testimonials blockquote {
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .home-testimonials footer {
    display: grid;
    gap: 0.3rem;
    margin-top: 3rem;
  }

  .home-testimonials footer strong {
    font-size: 0.78rem;
  }

  .home-testimonials footer span {
    color: var(--colour-muted);
    font-size: 0.68rem;
  }

  .home-testimonials__footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 2rem;
  }

  @media (max-width: 56rem) {
    .home-testimonials__grid {
      grid-template-columns: 1fr;
    }

    .home-testimonials article {
      min-height: auto;
    }
  }
</style>
