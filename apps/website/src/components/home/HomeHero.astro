---
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
import { site } from "../../config/site";
---

<section class="home-hero">
  <Container class="home-hero__inner">
    <div class="home-hero__top">
      <p class="home-hero__eyebrow">
        Independent technology company · Jaffna, Sri Lanka
      </p>

      <p class="home-hero__counter">
        Since {site.foundingYear}
      </p>
    </div>

    <div class="home-hero__statement">
      <h1>
        Technology
        <span>built around</span>
        the business.
      </h1>

      <div class="home-hero__intro">
        <p>
          We design and engineer websites, software,
          mobile products, AI systems, automation and
          digital infrastructure for organisations that
          need technology to perform in the real world.
        </p>

        <div class="home-hero__actions">
          <ButtonLink
            href="/get-a-quote/"
            label="Discuss your project"
          />

          <a
            href="/case-studies/"
            class="home-hero__work-link"
          >
            See our work
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="home-hero__lower">
      <div class="home-hero__manifesto">
        <span>01</span>

        <p>
          Strategy without delivery is a document.
          Delivery without understanding is expensive.
          We work across both.
        </p>
      </div>

      <div class="home-hero__disciplines">
        <span>Web</span>
        <span>Software</span>
        <span>Mobile</span>
        <span>AI</span>
        <span>Automation</span>
        <span>Cloud</span>
        <span>Growth</span>
      </div>
    </div>
  </Container>

  <div
    class="home-hero__orb home-hero__orb--one"
    aria-hidden="true"
  ></div>

  <div
    class="home-hero__orb home-hero__orb--two"
    aria-hidden="true"
  ></div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    min-height: min(58rem, calc(100svh - 4rem));

    background:
      radial-gradient(
        circle at 78% 26%,
        rgba(50, 95, 255, 0.2),
        transparent 27rem
      ),
      linear-gradient(
        135deg,
        #071426 0%,
        #0c1d34 54%,
        #102a4e 100%
      );

    color: #fff;
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;

    display: flex;
    flex-direction: column;

    min-height: min(58rem, calc(100svh - 4rem));

    padding-block:
      clamp(2.2rem, 5vw, 4rem)
      clamp(2rem, 4vw, 3rem);
  }

  .home-hero__top {
    display: flex;
    justify-content: space-between;
    gap: 2rem;

    color: rgba(255, 255, 255, 0.58);

    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-hero__top p {
    margin: 0;
  }

  .home-hero__statement {
    display: grid;

    grid-template-columns:
      minmax(0, 1.42fr)
      minmax(17rem, 0.58fr);

    gap: clamp(3rem, 8vw, 9rem);

    align-items: end;

    margin-block: auto;

    padding-block:
      clamp(5rem, 10vw, 9rem);
  }

  .home-hero h1 {
    max-width: 9.2ch;

    margin: 0;

    color: #fff;

    font-family: var(--font-serif);

    font-size:
      clamp(4.1rem, 9.2vw, 9.5rem);

    font-weight: 400;

    letter-spacing: -0.072em;

    line-height: 0.82;
  }

  .home-hero h1 span {
    display: block;

    color: rgba(255, 255, 255, 0.42);

    font-style: italic;
  }

  .home-hero__intro {
    max-width: 31rem;

    padding-bottom:
      clamp(0.4rem, 2vw, 1.4rem);
  }

  .home-hero__intro > p {
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-size:
      clamp(1rem, 1.45vw, 1.2rem);

    line-height: 1.7;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;

    align-items: center;

    gap: 1.4rem;

    margin-top: 2.2rem;
  }

  .home-hero__work-link {
    display: inline-flex;
    align-items: center;

    gap: 0.55rem;

    color: #fff;

    font-size: 0.76rem;
    font-weight: 750;
  }

  .home-hero__work-link span {
    font-size: 1rem;
  }

  .home-hero__lower {
    display: grid;

    grid-template-columns:
      minmax(0, 0.72fr)
      minmax(0, 1.28fr);

    gap: clamp(3rem, 7vw, 8rem);

    align-items: end;

    border-top:
      1px solid rgba(255, 255, 255, 0.16);

    padding-top: 1.4rem;
  }

  .home-hero__manifesto {
    display: grid;

    grid-template-columns: 2rem 1fr;

    gap: 1rem;

    max-width: 34rem;
  }

  .home-hero__manifesto span {
    color: #7f9cff;

    font-size: 0.6rem;
    font-weight: 800;
  }

  .home-hero__manifesto p {
    margin: 0;

    color: rgba(255, 255, 255, 0.62);

    font-size: 0.75rem;

    line-height: 1.65;
  }

  .home-hero__disciplines {
    display: flex;
    flex-wrap: wrap;

    justify-content: flex-end;

    gap: 0.45rem 1.5rem;

    color: rgba(255, 255, 255, 0.78);

    font-size: 0.7rem;
  }

  .home-hero__disciplines span::before {
    margin-right: 0.55rem;

    color: #6483ff;

    content: "•";
  }

  .home-hero__orb {
    position: absolute;
    z-index: 0;

    border-radius: 999rem;

    filter: blur(1px);

    opacity: 0.7;

    pointer-events: none;
  }

  .home-hero__orb--one {
    top: 18%;
    right: -11rem;

    width: 28rem;
    height: 28rem;

    border:
      1px solid rgba(129, 158, 255, 0.24);
  }

  .home-hero__orb--two {
    top: 29%;
    right: -3rem;

    width: 10rem;
    height: 10rem;

    background:
      radial-gradient(
        circle,
        rgba(92, 124, 255, 0.28),
        rgba(92, 124, 255, 0)
      );
  }

  @media (max-width: 62rem) {
    .home-hero__statement {
      grid-template-columns: 1fr;

      align-items: start;
    }

    .home-hero__intro {
      margin-left: 18%;
    }

    .home-hero__lower {
      grid-template-columns: 1fr;
    }

    .home-hero__disciplines {
      justify-content: flex-start;
    }
  }

  @media (max-width: 42rem) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__inner {
      min-height: auto;
    }

    .home-hero__top {
      align-items: flex-start;
    }

    .home-hero__counter {
      text-align: right;
    }

    .home-hero__statement {
      padding-block:
        5.5rem 5rem;
    }

    .home-hero h1 {
      font-size:
        clamp(3.7rem, 18vw, 6rem);
    }

    .home-hero__intro {
      margin-left: 0;
    }

    .home-hero__disciplines {
      gap: 0.55rem 1rem;
    }
  }
</style>
