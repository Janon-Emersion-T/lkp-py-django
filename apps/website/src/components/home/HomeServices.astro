---
import {
  serviceFamilies,
  serviceGroups,
} from "../../config/services";

import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextLink from "../ui/TextLink.astro";
---

<section class="home-services section-space">
  <Container>
    <SectionHeading
      eyebrow="What we do"
      title="One technology partner across build, growth and operations."
      description="LKProfessionals brings together engineering, infrastructure, digital growth and technology advisory capability under one operating model."
      align="split"
    />

    <div class="home-services__groups">
      {
        serviceGroups.map((group) => {
          const services =
            serviceFamilies.filter(
              (service) =>
                service.group === group.name,
            );

          return (
            <section class="home-service-group">
              <header>
                <span>
                  {group.name}
                </span>

                <div>
                  <h3>
                    {group.statement}
                  </h3>

                  <p>
                    {group.description}
                  </p>
                </div>
              </header>

              <div class="home-service-group__items">
                {
                  services.map((service) => (
                    <a
                      href={service.href}
                      class="home-service-item"
                    >
                      <span>
                        {service.number}
                      </span>

                      <strong>
                        {service.title}
                      </strong>

                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        width="17"
                        height="17"
                      >
                        <path
                          d="M3 10h14M12 5l5 5-5 5"
                          fill="none"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                        />
                      </svg>
                    </a>
                  ))
                }
              </div>
            </section>
          );
        })
      }
    </div>

    <div class="home-services__footer">
      <TextLink
        href="/services/"
        label="Explore all services"
      />
    </div>
  </Container>
</section>

<style>
  .home-services {
    background: var(--colour-white);
  }

  .home-services__groups {
    border-top: 1px solid var(--colour-line);
  }

  .home-service-group {
    display: grid;
    grid-template-columns:
      minmax(15rem, 0.55fr)
      minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    border-bottom: 1px solid var(--colour-line);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .home-service-group header {
    display: grid;
    gap: 1.5rem;
  }

  .home-service-group header > span {
    color: var(--colour-accent);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-service-group h3 {
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .home-service-group header p {
    max-width: 32rem;
    margin: 0.9rem 0 0;
    color: var(--colour-muted);
    font-size: 0.88rem;
  }

  .home-service-group__items {
    border-top: 1px solid var(--colour-line);
  }

  .home-service-item {
    display: grid;
    grid-template-columns:
      2.5rem
      minmax(0, 1fr)
      auto;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid var(--colour-line);
    padding-block: 1rem;
    transition:
      color 160ms ease,
      padding-left 160ms ease;
  }

  .home-service-item:hover {
    color: var(--colour-accent-dark);
    padding-left: 0.35rem;
  }

  .home-service-item > span {
    color: var(--colour-muted);
    font-size: 0.6rem;
  }

  .home-service-item strong {
    font-size: 0.84rem;
    font-weight: 700;
  }

  .home-services__footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 2rem;
  }

  @media (max-width: 54rem) {
    .home-service-group {
      grid-template-columns: 1fr;
    }
  }
</style>
