---
import {
  serviceFamilies,
  serviceGroups,
} from "../../config/services";

import Container from "../ui/Container.astro";
---

<section class="home-services">
  <Container>
    <header class="home-services__heading">
      <div>
        <p>Capabilities</p>

        <h2>
          One partner.
          <em>Different disciplines.</em>
        </h2>
      </div>

      <div>
        <p>
          Build, grow, operate and improve the
          technology around your organisation without
          stitching together a different supplier for
          every connected problem.
        </p>

        <a href="/services/">
          All services
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="home-services__groups">
      {
        serviceGroups.map((group, groupIndex) => {
          const services =
            serviceFamilies.filter(
              (service) =>
                service.group === group.name,
            );

          return (
            <article class="home-service-group">
              <div class="home-service-group__intro">
                <span class="home-service-group__number">
                  {String(groupIndex + 1).padStart(2, "0")}
                </span>

                <p class="home-service-group__name">
                  {group.name}
                </p>

                <h3>
                  {group.statement}
                </h3>

                <p class="home-service-group__description">
                  {group.description}
                </p>
              </div>

              <div class="home-service-group__links">
                {
                  services.map((service) => (
                    <a href={service.href}>
                      <span>{service.title}</span>

                      <span aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  ))
                }
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .home-services {
    overflow: hidden;

    background: #0b1728;

    padding-block:
      clamp(7rem, 13vw, 12rem);

    color: #fff;
  }

  .home-services__heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(18rem, 0.45fr);

    gap: clamp(3rem, 9vw, 9rem);

    align-items: end;

    margin-bottom:
      clamp(5rem, 10vw, 9rem);
  }

  .home-services__heading > div:first-child > p {
    margin: 0 0 1.2rem;

    color: #7d9cff;

    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-services__heading h2 {
    max-width: 10ch;

    margin: 0;

    font-family: var(--font-serif);

    font-size:
      clamp(3.5rem, 7vw, 7rem);

    font-weight: 400;

    letter-spacing: -0.066em;

    line-height: 0.9;
  }

  .home-services__heading em {
    display: block;

    color: rgba(255, 255, 255, 0.43);

    font-weight: 400;
  }

  .home-services__heading > div:last-child {
    color: rgba(255, 255, 255, 0.63);

    font-size: 0.84rem;

    line-height: 1.75;
  }

  .home-services__heading > div:last-child p {
    margin: 0;
  }

  .home-services__heading a {
    display: inline-flex;

    gap: 0.55rem;

    margin-top: 1.7rem;

    color: #fff;

    font-size: 0.72rem;
    font-weight: 750;
  }

  .home-services__groups {
    border-top:
      1px solid rgba(255,255,255,0.18);
  }

  .home-service-group {
    display: grid;

    grid-template-columns:
      minmax(18rem, 0.7fr)
      minmax(0, 1fr);

    gap: clamp(3rem, 8vw, 8rem);

    padding-block:
      clamp(3rem, 6vw, 5.5rem);

    border-bottom:
      1px solid rgba(255,255,255,0.18);
  }

  .home-service-group__intro {
    display: grid;

    grid-template-columns:
      2.5rem
      minmax(0, 1fr);
  }

  .home-service-group__number {
    color: #7897ff;

    font-size: 0.62rem;
    font-weight: 800;
  }

  .home-service-group__name {
    margin: 0;

    color: rgba(255,255,255,0.47);

    font-size: 0.63rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-service-group h3 {
    grid-column: 2;

    max-width: 15ch;

    margin: 2rem 0 0;

    font-family: var(--font-serif);

    font-size:
      clamp(2rem, 4vw, 3.4rem);

    font-weight: 400;

    letter-spacing: -0.045em;

    line-height: 1;
  }

  .home-service-group__description {
    grid-column: 2;

    max-width: 32rem;

    margin: 1rem 0 0;

    color: rgba(255,255,255,0.53);

    font-size: 0.78rem;

    line-height: 1.7;
  }

  .home-service-group__links {
    display: flex;
    flex-direction: column;

    justify-content: center;
  }

  .home-service-group__links a {
    display: flex;

    justify-content: space-between;

    gap: 1rem;

    border-bottom:
      1px solid rgba(255,255,255,0.15);

    padding-block: 1rem;

    color: rgba(255,255,255,0.86);

    font-size:
      clamp(0.9rem, 1.5vw, 1.1rem);

    transition:
      padding-left 180ms ease,
      color 180ms ease;
  }

  .home-service-group__links a:first-child {
    border-top:
      1px solid rgba(255,255,255,0.15);
  }

  .home-service-group__links a:hover {
    padding-left: 0.5rem;

    color: #8ca6ff;
  }

  @media (max-width: 56rem) {
    .home-services__heading,
    .home-service-group {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .home-service-group__intro {
      grid-template-columns:
        2rem 1fr;
    }
  }
</style>
