---
import {
  proofPoints,
} from "../../config/why-choose-lkp";

import Container from "../ui/Container.astro";
---

<section
  class="home-proof"
  aria-label="LKProfessionals company facts"
>
  <Container class="home-proof__grid">
    {
      proofPoints.map((point) => (
        <article class="home-proof__item">
          <p class="home-proof__label">
            {point.label}
          </p>

          <h2>
            {point.value}
          </h2>

          <p>
            {point.note}
          </p>
        </article>
      ))
    }
  </Container>
</section>

<style>
  .home-proof {
    background: var(--colour-white);
    border-top: 1px solid var(--colour-line);
    border-bottom: 1px solid var(--colour-line);
  }

  .home-proof__grid {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .home-proof__item {
    min-height: 13rem;
    border-left: 1px solid var(--colour-line);
    padding: 2rem;
  }

  .home-proof__item:last-child {
    border-right: 1px solid var(--colour-line);
  }

  .home-proof__label {
    margin: 0 0 2rem;
    color: var(--colour-muted);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-proof h2 {
    margin: 0;
    color: var(--colour-accent);
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .home-proof__item > p:last-child {
    margin: 0.8rem 0 0;
    color: var(--colour-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  @media (max-width: 55rem) {
    .home-proof__grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .home-proof__item:nth-child(2) {
      border-right: 1px solid var(--colour-line);
    }

    .home-proof__item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--colour-line);
    }
  }

  @media (max-width: 34rem) {
    .home-proof__grid {
      grid-template-columns: 1fr;
    }

    .home-proof__item {
      min-height: auto;
      border-right: 1px solid var(--colour-line);
      border-bottom: 1px solid var(--colour-line);
    }
  }
</style>
