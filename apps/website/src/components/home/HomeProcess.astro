---
import {
  processStages,
} from "../../config/process";

import Container from "../ui/Container.astro";
---

<section class="home-process">
  <Container>
    <header class="home-process__heading">
      <div>
        <p>How we work</p>

        <h2>
          Structure without
          <em>the theatre.</em>
        </h2>
      </div>

      <div>
        <p>
          Seven stages keep decisions, ownership and
          progress visible from first conversation
          through long-term improvement.
        </p>

        <a href="/about/our-process/">
          Our full process ↗
        </a>
      </div>
    </header>

    <ol class="home-process__stages">
      {
        processStages.map((stage, index) => (
          <li>
            <div class="home-process__stage-number">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="home-process__stage-title">
              <span>{stage.shortTitle}</span>

              <h3>{stage.title}</h3>
            </div>

            <p>
              {stage.description}
            </p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .home-process {
    background: #f7f5f0;

    padding-block:
      clamp(7rem, 13vw, 12rem);
  }

  .home-process__heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(16rem, 0.42fr);

    gap: clamp(3rem, 9vw, 9rem);

    align-items: end;

    margin-bottom:
      clamp(5rem, 9vw, 8rem);
  }

  .home-process__heading
  > div:first-child > p {
    margin: 0 0 1.2rem;

    color: #355bc4;

    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-process__heading h2 {
    max-width: 11ch;

    margin: 0;

    color: #112033;

    font-family: var(--font-serif);

    font-size:
      clamp(3.3rem, 6.8vw, 6.5rem);

    font-weight: 400;

    letter-spacing: -0.064em;

    line-height: 0.91;
  }

  .home-process__heading em {
    display: block;

    color: #78828e;

    font-weight: 400;
  }

  .home-process__heading
  > div:last-child {
    color: #6c7888;

    font-size: 0.82rem;

    line-height: 1.75;
  }

  .home-process__heading
  > div:last-child p {
    margin: 0;
  }

  .home-process__heading a {
    display: inline-block;

    margin-top: 1.8rem;

    border-bottom:
      1px solid #112033;

    padding-bottom: 0.2rem;

    color: #112033;

    font-size: 0.7rem;
    font-weight: 750;
  }

  .home-process__stages {
    margin: 0;
    padding: 0;

    list-style: none;

    border-top:
      1px solid #cfd4d9;
  }

  .home-process__stages li {
    display: grid;

    grid-template-columns:
      3rem
      minmax(13rem, 0.6fr)
      minmax(18rem, 1fr);

    gap: clamp(1rem, 5vw, 5rem);

    align-items: start;

    border-bottom:
      1px solid #cfd4d9;

    padding-block:
      clamp(1.5rem, 3vw, 2.3rem);

    transition:
      padding-left 180ms ease;
  }

  .home-process__stages li:hover {
    padding-left: 0.5rem;
  }

  .home-process__stage-number {
    color: #345ac4;

    font-size: 0.58rem;
    font-weight: 800;
  }

  .home-process__stage-title span {
    display: block;

    margin-bottom: 0.45rem;

    color: #8a94a1;

    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-process__stage-title h3 {
    margin: 0;

    color: #142237;

    font-family: var(--font-serif);

    font-size:
      clamp(1.45rem, 2.6vw, 2.2rem);

    font-weight: 400;

    letter-spacing: -0.035em;
  }

  .home-process__stages li > p {
    max-width: 46rem;

    margin: 0;

    color: #6c7888;

    font-size: 0.78rem;

    line-height: 1.7;
  }

  @media (max-width: 52rem) {
    .home-process__heading {
      grid-template-columns: 1fr;
    }

    .home-process__stages li {
      grid-template-columns:
        2rem 1fr;
    }

    .home-process__stages li > p {
      grid-column: 2;
    }
  }
</style>
