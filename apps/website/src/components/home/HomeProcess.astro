---
import {
  processStages,
} from "../../config/process";

import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextLink from "../ui/TextLink.astro";
---

<section class="home-process section-space">
  <Container>
    <SectionHeading
      eyebrow="How we work"
      title="Seven stages from requirement to improvement."
      description="Delivery stays structured without turning the process into theatre. Each stage exists to make decisions, ownership and progress clearer."
      align="split"
    />

    <ol class="home-process__timeline">
      {
        processStages.map((stage) => (
          <li>
            <span class="home-process__number">
              {stage.number}
            </span>

            <div>
              <span class="home-process__short">
                {stage.shortTitle}
              </span>

              <h3>
                {stage.title}
              </h3>

              <p>
                {stage.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="home-process__footer">
      <TextLink
        href="/about/our-process/"
        label="See our process"
      />
    </div>
  </Container>
</section>

<style>
  .home-process {
    background: var(--colour-paper);
  }

  .home-process__timeline {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--colour-line);
    list-style: none;
  }

  .home-process__timeline li {
    display: grid;
    grid-template-columns:
      4rem
      minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--colour-line);
    padding-block: 1.5rem;
  }

  .home-process__number {
    color: var(--colour-accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .home-process__timeline li > div {
    display: grid;
    grid-template-columns:
      minmax(8rem, 0.35fr)
      minmax(14rem, 0.65fr)
      minmax(18rem, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: start;
  }

  .home-process__short {
    color: var(--colour-muted);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-process h3 {
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .home-process p {
    margin: 0;
    color: var(--colour-muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .home-process__footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 2rem;
  }

  @media (max-width: 54rem) {
    .home-process__timeline li > div {
      grid-template-columns:
        minmax(8rem, 0.3fr)
        1fr;
    }

    .home-process p {
      grid-column: 2;
    }
  }

  @media (max-width: 36rem) {
    .home-process__timeline li {
      grid-template-columns:
        2rem
        1fr;
    }

    .home-process__timeline li > div {
      grid-template-columns: 1fr;
    }

    .home-process p {
      grid-column: auto;
    }
  }
</style>
