---
import { services } from "../../config/site";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextLink from "../ui/TextLink.astro";
---

<section class="services-overview section-space">
  <Container>
    <SectionHeading
      eyebrow="What we build"
      title="Technology that earns its place in the business."
      description="Every engagement is shaped around a real operational or commercial requirement. The objective is not more software. It is better business capability."
      align="split"
    />

    <div class="services-overview__list">
      {
        services.map((service) => (
          <article class="service-row">
            <div class="service-row__number">
              {service.number}
            </div>

            <div class="service-row__main">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>

            <ul class="service-row__capabilities">
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>

            <div class="service-row__action">
              <TextLink
                href={service.href}
                label="Explore"
              />
            </div>
          </article>
        ))
      }
    </div>

    <div class="services-overview__footer">
      <TextLink href="/services" label="View all services" />
    </div>
  </Container>
</section>

<style>
  .services-overview {
    background: var(--colour-white);
  }

  .services-overview__list {
    border-top: 1px solid var(--colour-line);
  }

  .service-row {
    display: grid;
    grid-template-columns:
      4rem
      minmax(18rem, 1.3fr)
      minmax(14rem, 0.75fr)
      auto;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--colour-line);
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .service-row__number {
    color: var(--colour-accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .service-row h3 {
    margin: 0;
    color: var(--colour-ink-strong);
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.5vw, 3.3rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .service-row__main p {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--colour-muted);
  }

  .service-row__capabilities {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    color: var(--colour-muted);
    font-size: 0.88rem;
    list-style: none;
  }

  .service-row__capabilities li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .service-row__capabilities li::before {
    width: 0.35rem;
    height: 0.35rem;
    background: var(--colour-accent);
    content: "";
  }

  .service-row__action {
    padding-top: 0.2rem;
  }

  .services-overview__footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 2rem;
  }

  @media (max-width: 62rem) {
    .service-row {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
    }

    .service-row__capabilities {
      grid-column: 2;
    }

    .service-row__action {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 42rem) {
    .service-row {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
    }

    .service-row__capabilities,
    .service-row__action {
      grid-column: 2;
    }

    .service-row__action {
      grid-row: auto;
    }
  }
</style>
