---
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
---

<section class="home-hero">
  <Container class="home-hero__container">
    <div class="home-hero__content">
      <p class="eyebrow">Technology built around the business</p>

      <h1 class="display-heading">
        Useful digital systems.
        <span>Built to last.</span>
      </h1>

      <div class="home-hero__summary">
        <p class="body-large">
          LKProfessionals designs and develops websites, business software
          and digital growth systems for organisations that value reliability,
          clarity and long-term technical ownership.
        </p>

        <div class="home-hero__actions">
          <ButtonLink
            href="/get-a-quote/"
            label="Discuss your project"
          />

          <ButtonLink
            href="/case-studies"
            label="See our work"
            variant="secondary"
          />
        </div>
      </div>
    </div>

    <div class="home-hero__visual">
      <div class="home-hero__image-wrap">
        <img
          src="/brand/home-hero.jpg"
          alt="A professional team working together on a digital project"
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
          class="home-hero__image"
        />
      </div>

      <div class="home-hero__caption">
        <span>Strategy</span>
        <span>Design</span>
        <span>Development</span>
        <span>Growth</span>
      </div>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem) 0;
  }

  .home-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.65fr);
    align-items: end;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -0.5rem;
  }

  .display-heading span {
    display: block;
    color: var(--colour-accent);
    font-style: italic;
  }

  .home-hero__summary {
    display: grid;
    gap: 2rem;
    padding-bottom: 0.5rem;
  }

  .home-hero__summary p {
    margin: 0;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-hero__visual {
    position: relative;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .home-hero__image-wrap {
    aspect-ratio: 16 / 7.5;
    overflow: hidden;
    background: var(--colour-soft-blue);
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__caption {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-right: 1px solid var(--colour-line);
    border-bottom: 1px solid var(--colour-line);
    border-left: 1px solid var(--colour-line);
  }

  .home-hero__caption span {
    padding: 0.9rem 1rem;
    border-right: 1px solid var(--colour-line);
    color: var(--colour-muted);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-align: center;
    text-transform: uppercase;
  }

  .home-hero__caption span:last-child {
    border-right: 0;
  }

  @media (max-width: 55rem) {
    .home-hero__content {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .home-hero__summary {
      max-width: 42rem;
    }

    .home-hero__image-wrap {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 38rem) {
    .home-hero__caption {
      grid-template-columns: repeat(2, 1fr);
    }

    .home-hero__caption span:nth-child(2) {
      border-right: 0;
    }

    .home-hero__caption span:nth-child(-n + 2) {
      border-bottom: 1px solid var(--colour-line);
    }
  }
</style>
