---
import {
  financeFlow,
} from "../../../config/finance-industry";
---

<section
  class="finance-flow"
  aria-labelledby="finance-flow-title"
>
  <div class="site-container">
    <header class="finance-flow__heading">
      <p>Controlled workflow</p>

      <h2 id="finance-flow-title">
        Preserve control from capture to reporting.
      </h2>
    </header>

    <div class="finance-flow__steps">
      {
        financeFlow.map((step) => (
          <article>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .finance-flow {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #ffffff;
  }

  .finance-flow__heading {
    max-width: 49rem;
    margin-bottom: 3.5rem;
  }

  .finance-flow__heading > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .finance-flow h2 {
    max-width: 12ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .finance-flow__steps {
    display: grid;
    grid-template-columns:
      repeat(6, minmax(0, 1fr));
    border-top: 1px solid #dce3ec;
  }

  .finance-flow article {
    border-right: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    padding: 1.3rem 1rem;
  }

  .finance-flow article:first-child {
    padding-left: 0;
  }

  .finance-flow article:last-child {
    border-right: 0;
  }

  .finance-flow article > span {
    color: #0b2f8f;
    font-size: 0.56rem;
    font-weight: 800;
  }

  .finance-flow h3 {
    margin: 1rem 0 0;
    color: #293b53;
    font-size: 0.79rem;
  }

  .finance-flow article p {
    margin: 0.55rem 0 0;
    color: #788497;
    font-size: 0.66rem;
    line-height: 1.65;
  }

  @media (max-width: 64rem) {
    .finance-flow__steps {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .finance-flow__steps {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .finance-flow__steps {
      grid-template-columns: 1fr;
    }

    .finance-flow article,
    .finance-flow article:first-child {
      border-right: 0;
      padding-inline: 0;
    }
  }
</style>
