---
import {
  industryCapabilities,
} from "../../config/industries";
---

<section
  class="industries-capabilities"
  aria-labelledby="industries-capabilities-title"
>
  <div class="site-container industries-capabilities__layout">
    <div>
      <p>Across industries</p>

      <h2 id="industries-capabilities-title">
        Sector knowledge matters. So does engineering discipline.
      </h2>

      <div class="industries-capabilities__statement">
        <span>Industry context</span>
        <i>+</i>
        <span>Technology capability</span>
        <i>=</i>
        <strong>Useful systems</strong>
      </div>
    </div>

    <div class="industries-capabilities__list">
      {
        industryCapabilities.map((capability) => (
          <article>
            <span>{capability.number}</span>

            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .industries-capabilities {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #f6f8fb;
  }

  .industries-capabilities__layout {
    display: grid;
    grid-template-columns:
      minmax(17rem, 0.72fr)
      minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 7rem);
  }

  .industries-capabilities__layout
    > div:first-child > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .industries-capabilities h2 {
    max-width: 12ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .industries-capabilities__statement {
    display: flex;
    max-width: 28rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    border-top: 1px solid #d6dee8;
    margin-top: 2.5rem;
    padding-top: 1rem;
    color: #68778c;
    font-size: 0.6rem;
  }

  .industries-capabilities__statement i {
    color: #9aa5b5;
    font-style: normal;
  }

  .industries-capabilities__statement strong {
    color: #0b2f8f;
    font-weight: 800;
  }

  .industries-capabilities__list {
    border-top: 1px solid #dce3ec;
  }

  .industries-capabilities article {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid #dce3ec;
    padding-block: 1.2rem;
  }

  .industries-capabilities article > span {
    color: #0b2f8f;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .industries-capabilities h3 {
    margin: 0;
    color: #293b53;
    font-size: 0.82rem;
  }

  .industries-capabilities article p {
    max-width: 43rem;
    margin: 0.45rem 0 0;
    color: #788497;
    font-size: 0.7rem;
    line-height: 1.65;
  }

  @media (max-width: 52rem) {
    .industries-capabilities__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
