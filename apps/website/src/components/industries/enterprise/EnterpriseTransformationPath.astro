---
import {
  enterpriseStages,
} from "../../../config/enterprise-industry";
---

<section
  class="enterprise-path"
  aria-labelledby="enterprise-path-title"
>
  <div class="site-container">
    <header class="enterprise-path__heading">
      <p>Controlled transformation</p>

      <h2 id="enterprise-path-title">
        Change the environment without destabilising the operation.
      </h2>
    </header>

    <div class="enterprise-path__steps">
      {
        enterpriseStages.map((stage) => (
          <article>
            <span>{stage.number}</span>
            <h3>{stage.title}</h3>
            <p>{stage.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .enterprise-path {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: #ffffff;
  }

  .enterprise-path__heading {
    max-width: 50rem;
    margin-bottom: 3.5rem;
  }

  .enterprise-path__heading > p {
    margin: 0 0 1rem;
    color: #0b2f8f;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .enterprise-path h2 {
    max-width: 13ch;
    margin: 0;
    color: #0d203c;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .enterprise-path__steps {
    display: grid;
    grid-template-columns:
      repeat(6, minmax(0, 1fr));
    border-top: 1px solid #dce3ec;
  }

  .enterprise-path article {
    border-right: 1px solid #dce3ec;
    border-bottom: 1px solid #dce3ec;
    padding: 1.3rem 1rem;
  }

  .enterprise-path article:first-child {
    padding-left: 0;
  }

  .enterprise-path article:last-child {
    border-right: 0;
  }

  .enterprise-path article > span {
    color: #0b2f8f;
    font-size: 0.56rem;
    font-weight: 800;
  }

  .enterprise-path h3 {
    margin: 1rem 0 0;
    color: #293b53;
    font-size: 0.79rem;
  }

  .enterprise-path article p {
    margin: 0.55rem 0 0;
    color: #788497;
    font-size: 0.66rem;
    line-height: 1.65;
  }

  @media (max-width: 64rem) {
    .enterprise-path__steps {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .enterprise-path__steps {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .enterprise-path__steps {
      grid-template-columns: 1fr;
    }

    .enterprise-path article,
    .enterprise-path article:first-child {
      border-right: 0;
      padding-inline: 0;
    }
  }
</style>
